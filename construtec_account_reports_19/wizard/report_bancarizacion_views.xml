<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_reporte_bancarizacion_form" model="ir.ui.view">
        <field name="name">wizard.reporte.bancarizacion.form</field>
        <field name="model">wizard.reporte.bancarizacion</field>
        <field name="arch" type="xml">
            <form string="Reporte Bancarización">
                <field name="state" invisible="1"/>
                <field name="name" invisible="1"/>
                <group col="4" invisible="state != 'choose'">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_start" required="1"/>
                    <field name="date_end" required="1"/>
                    <field name="journal_ids" widget="many2many_tags"/>
                </group>
                <div invisible="state != 'get'">
                    <h2>Descargar Archivo - Reporte Bancarización</h2>
                    <p>Archivo: <field name="data" readonly="1" filename="name"/></p>
                </div>
                <footer>
                    <button name="print_xls_reporte_bancarizacion" string="Generar Reporte" type="object" class="oe_highlight" invisible="state != 'choose'"/>
                    <button string="Cancelar" special="cancel" invisible="state != 'choose'"/>
                    <button name="got_back" string="Atrás" type="object" class="oe_highlight" invisible="state != 'get'"/>
                    <button string="Cerrar" special="cancel" invisible="state != 'get'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_reporte_bancarizacion" model="ir.actions.act_window">
        <field name="name">Reporte Bancarización</field>
        <field name="res_model">wizard.reporte.bancarizacion</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
