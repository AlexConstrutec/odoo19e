<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solo hace algo en la instalación Solicitante (Community); en Enterprise termina sin hacer nada. -->
    <record id="ir_cron_analytic_geo_sync" model="ir.cron">
        <field name="name">Cuenta Analítica: sincronizar ubicación geográfica (Community y Enterprise)</field>
        <field name="model_id" ref="analytic.model_account_analytic_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_geo()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
