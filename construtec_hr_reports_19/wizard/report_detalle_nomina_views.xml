<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_reporte_detalle_nomina_form" model="ir.ui.view">
        <field name="name">wizard.reporte.detalle.nomina.form</field>
        <field name="model">wizard.reporte.detalle.nomina</field>
        <field name="arch" type="xml">
            <form string="Detalle de Recibos de Nómina">
                <group col="4">
                    <field name="date_start" required="1"/>
                    <field name="date_end" required="1"/>
                    <field name="payslip_run_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_ver" string="Visor" type="object" class="oe_highlight"/>
                    <button name="action_excel" string="Excel" type="object" class="oe_highlight"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_reporte_detalle_nomina" model="ir.actions.act_window">
        <field name="name">Detalle de Recibos de Nómina</field>
        <field name="res_model">wizard.reporte.detalle.nomina</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="wizard_reporte_detalle_nomina_line_list_view" model="ir.ui.view">
        <field name="name">wizard.reporte.detalle.nomina.line.list</field>
        <field name="model">wizard.reporte.detalle.nomina.line</field>
        <field name="arch" type="xml">
            <list string="Detalle de Nómina" create="0" edit="0" delete="0">
                <field name="employee_id" optional="show"/>
                <field name="codigo_empleado" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="payslip_run_id" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="salario_base" sum="Total" optional="show"/>
                <field name="bonificacion_incentivo" sum="Total" optional="show"/>
                <field name="bonificacion_fija" sum="Total" optional="show"/>
                <field name="bonificacion_ajuste" sum="Total" optional="show"/>
                <field name="bonificacion_asueto" sum="Total" optional="show"/>
                <field name="bonificacion_productividad" sum="Total" optional="show"/>
                <field name="alimentacion" sum="Total" optional="show"/>
                <field name="horas_extra" sum="Total" optional="show"/>
                <field name="bonificacion_horas" sum="Total" optional="show"/>
                <field name="bonificaciones_extras" sum="Total" optional="show"/>
                <field name="gratificacion" sum="Total" optional="show"/>
                <field name="devolucion_isr" sum="Total" optional="show"/>
                <field name="bono14_pago" sum="Total" optional="show"/>
                <field name="aguinaldo_pago" sum="Total" optional="show"/>
                <field name="indemnizacion_pago" sum="Total" optional="show"/>
                <field name="vacaciones_pago" sum="Total" optional="show"/>
                <field name="igss_patronal" sum="Total" optional="show"/>
                <field name="complemento_igss_patronal" sum="Total" optional="show"/>
                <field name="irtra" sum="Total" optional="show"/>
                <field name="intecap" sum="Total" optional="show"/>
                <field name="salario_devengado" sum="Total" optional="show"/>
                <field name="igss_laboral" sum="Total" optional="show"/>
                <field name="complemento_igss_laboral" sum="Total" optional="show"/>
                <field name="isr_asalariados" sum="Total" optional="show"/>
                <field name="vales" sum="Total" optional="show"/>
                <field name="otros_descuentos" sum="Total" optional="show"/>
                <field name="prestamos" sum="Total" optional="show"/>
                <field name="retencion_isr" sum="Total" optional="show"/>
                <field name="total_deducciones" sum="Total" optional="show"/>
                <field name="salario_neto" sum="Total" optional="show"/>
                <field name="otros_conceptos" sum="Total" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
