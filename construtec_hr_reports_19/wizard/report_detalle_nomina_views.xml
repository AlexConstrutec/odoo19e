<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_reporte_detalle_nomina_form" model="ir.ui.view">
        <field name="name">wizard.reporte.detalle.nomina.form</field>
        <field name="model">wizard.reporte.detalle.nomina</field>
        <field name="arch" type="xml">
            <form string="Detalle de Recibos de Nómina">
                <field name="state" invisible="1"/>
                <field name="name" invisible="1"/>
                <group col="4" invisible="state != 'choose'">
                    <field name="date_start" required="1"/>
                    <field name="date_end" required="1"/>
                    <field name="payslip_run_ids" widget="many2many_tags"/>
                </group>
                <div invisible="state != 'view'">
                    <h2>Detalle de Nómina</h2>
                    <div style="overflow-x:auto;">
                        <field name="preview_html" widget="html" nolabel="1"/>
                    </div>
                </div>
                <div invisible="state != 'get'">
                    <h2>Descargar Archivo - Detalle de Nómina</h2>
                    <p>Archivo: <field name="data" readonly="1" filename="name"/></p>
                </div>
                <footer>
                    <button name="action_ver" string="Visor" type="object" class="oe_highlight" invisible="state != 'choose'"/>
                    <button name="action_excel" string="Excel" type="object" class="oe_highlight" invisible="state != 'choose'"/>
                    <button string="Cancelar" special="cancel" invisible="state != 'choose'"/>
                    <button name="got_back" string="Atrás" type="object" class="oe_highlight" invisible="state not in ('view', 'get')"/>
                    <button string="Cerrar" special="cancel" invisible="state not in ('view', 'get')"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_reporte_detalle_nomina" model="ir.actions.act_window">
        <field name="name">Detalle de Recibos de Nómina</field>
        <field name="res_model">wizard.reporte.detalle.nomina</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
