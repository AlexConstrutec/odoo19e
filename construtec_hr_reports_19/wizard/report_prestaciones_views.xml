<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_reporte_prestaciones_laborales_form" model="ir.ui.view">
        <field name="name">wizard.reporte.prestaciones.laborales.form</field>
        <field name="model">wizard.reporte.prestaciones.laborales</field>
        <field name="arch" type="xml">
            <form string="Reporte de Prestaciones Laborales">
                <field name="state" invisible="1"/>
                <field name="name" invisible="1"/>
                <group col="4" invisible="state != 'choose'">
                    <field name="date_start" required="1"/>
                    <field name="date_end" required="1"/>
                    <field name="employee_id" required="1" widget="many2many_tags"/>
                </group>
                <div invisible="state != 'get'">
                    <h2>Descargar Archivo - Reporte de Prestaciones Laborales</h2>
                    <p>Archivo: <field name="data" readonly="1" filename="name"/></p>
                </div>
                <footer>
                    <button name="print_xls_reporte_prestaciones_laborales" string="Generar Reporte" type="object" class="oe_highlight" invisible="state != 'choose'"/>
                    <button string="Cancelar" special="cancel" invisible="state != 'choose'"/>
                    <button name="got_back" string="Atrás" type="object" class="oe_highlight" invisible="state != 'get'"/>
                    <button string="Cerrar" special="cancel" invisible="state != 'get'"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_wizard_reporte_prestaciones_laborales" model="ir.actions.act_window">
        <field name="name">Reporte de Prestaciones Laborales</field>
        <field name="res_model">wizard.reporte.prestaciones.laborales</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

