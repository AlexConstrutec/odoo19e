<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_voucher" model="mail.template">
            <field name="name">Boleta de Pago - Correo</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="auto_delete" eval="False"/>
            <field name="subject">Recibo de pago</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="body_html">
                <![CDATA[
                <div>
                    <p>Estimado(a) <t t-out="object.employee_id.name"/>,</p>
                    <p>Adjunto comprobante de compensación correspondiente al período.</p>
                </div>
                   ]]>
            </field>
            <field name="report_template_ids" eval="[(6, 0, [ref('construtec_hr_reports_19.report_voucher')])]"/>
        </record>
    </data>
</odoo>
