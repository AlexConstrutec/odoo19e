<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_constancia_laboral" model="report.paperformat">
        <field name="name">Formato Carta para Constancia Laboral</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">30</field>
        <field name="margin_right">30</field>
        <field name="orientation">Portrait</field>
        <field name="disable_shrinking">True</field>
    </record>

    <record id="report_constancia_laboral" model="ir.actions.report">
        <field name="name">Constancia Laboral</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.constancia_laboral</field>
        <field name="report_file">construtec_hr_reports_19.constancia_laboral</field>
        <field name="print_report_name">'Constancia_laboral - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_constancia_laboral"/>
    </record>

    <record id="report_constancia_laboral_no_vigente" model="ir.actions.report">
        <field name="name">Constancia Laboral no Vigente</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.constancia_laboral_no_vigente</field>
        <field name="report_file">construtec_hr_reports_19.constancia_laboral_no_vigente</field>
        <field name="print_report_name">'Constancia_laboral_no_vigente - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_constancia_laboral"/>
    </record>

    <record id="report_constancia_ingresos" model="ir.actions.report">
        <field name="name">Constancia de Ingresos</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.constancia_ingresos</field>
        <field name="report_file">construtec_hr_reports_19.constancia_ingresos</field>
        <field name="print_report_name">'Constancia_ingresos - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_constancia_laboral"/>
    </record>

    <record id="report_historial_laboral" model="ir.actions.report">
        <field name="name">Historial Laboral</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.historial_laboral</field>
        <field name="report_file">construtec_hr_reports_19.historial_laboral</field>
        <field name="print_report_name">'Historial_laboral - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_constancia_laboral"/>
    </record>

    <record id="paperformat_irtra" model="report.paperformat">
        <field name="name">Formato Carta para IRTRA</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="orientation">Portrait</field>
        <field name="disable_shrinking">True</field>
    </record>

    <record id="report_solicitud_irtra" model="ir.actions.report">
        <field name="name">Solicitud IRTRA</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.solicitud_irtra</field>
        <field name="report_file">construtec_hr_reports_19.solicitud_irtra</field>
        <field name="print_report_name">'Solicitud_IRTRA - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_irtra"/>
    </record>

    <record id="paperformat_voucher" model="report.paperformat">
        <field name="name">Recibo de Pago</field>
        <field name="default" eval="False"/>
        <field name="format">Legal</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="orientation">Portrait</field>
        <field name="disable_shrinking">True</field>
        <field name="header_spacing">0</field>
    </record>

    <record id="report_voucher" model="ir.actions.report">
        <field name="name">Recibo de Pago</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_hr_reports_19.salary_voucher</field>
        <field name="report_file">construtec_hr_reports_19.salary_voucher</field>
        <field name="print_report_name">'Recibo_Pago - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="paperformat_voucher"/>
    </record>
</odoo>
