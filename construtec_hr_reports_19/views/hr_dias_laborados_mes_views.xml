<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_dias_laborados_mes_list" model="ir.ui.view">
        <field name="name">hr.dias.laborados.mes.list</field>
        <field name="model">hr.dias.laborados.mes</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="anio"/>
                <field name="mes"/>
                <field name="dias_calendario"/>
                <field name="descanso_semanal"/>
                <field name="asueto"/>
                <field name="total_ausencia"/>
                <field name="dias_laborados"/>
            </list>
        </field>
    </record>

    <record id="action_hr_dias_laborados_mes" model="ir.actions.act_window">
        <field name="name">Días Laborados por Mes</field>
        <field name="res_model">hr.dias.laborados.mes</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_hr_dias_laborados_mes" name="Días Laborados por Mes" action="action_hr_dias_laborados_mes"
              parent="hr.menu_human_resources_configuration" sequence="50"/>
</odoo>
