<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construtec_whatsapp_log_list" model="ir.ui.view">
        <field name="name">construtec.whatsapp.log.list</field>
        <field name="model">construtec.whatsapp.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Fecha"/>
                <field name="to_number"/>
                <field name="template_id"/>
                <field name="success" widget="boolean_toggle" readonly="1"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_construtec_whatsapp_log" model="ir.actions.act_window">
        <field name="name">Registro de WhatsApp</field>
        <field name="res_model">construtec.whatsapp.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
