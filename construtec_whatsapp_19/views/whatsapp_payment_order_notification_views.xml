<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construtec_whatsapp_payment_order_notification_list" model="ir.ui.view">
        <field name="name">construtec.whatsapp.payment.order.notification.list</field>
        <field name="model">construtec.whatsapp.payment.order.notification</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="state"/>
                <field name="template_id"/>
                <field name="recipient_group_id"/>
                <field name="notify_interesado"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_whatsapp_payment_order_notification_form" model="ir.ui.view">
        <field name="name">construtec.whatsapp.payment.order.notification.form</field>
        <field name="model">construtec.whatsapp.payment.order.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación de Orden de Pago por WhatsApp">
                <sheet>
                    <group>
                        <field name="state"/>
                        <field name="template_id"/>
                        <field name="recipient_group_id"/>
                        <field name="notify_interesado"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        Se le mandan a la plantilla, en orden: {{1}} = nombre de la Orden,
                        {{2}} = contacto, {{3}} = monto, {{4}} = link a la Orden. Verifica en Meta
                        Business Manager que la plantilla elegida tenga exactamente esas 4
                        variables en el cuerpo antes de activarla.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construtec_whatsapp_payment_order_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones de Órdenes de Pago</field>
        <field name="res_model">construtec.whatsapp.payment.order.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define qué plantilla (y a quién) se manda cuando una Orden de Pago llega a un
                estado dado.
            </p>
            <p>
                También hace falta activar "Notificar Órdenes de Pago por WhatsApp" en Ajustes >
                Facturación > WhatsApp.
            </p>
        </field>
    </record>
</odoo>
