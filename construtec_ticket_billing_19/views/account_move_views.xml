<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_ticket_billing" model="ir.ui.view">
        <field name="name">account.move.view.form.ticket.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_ticket_mirrors"
                        class="oe_stat_button" icon="fa-ticket"
                        invisible="ticket_mirror_count == 0">
                    <field name="ticket_mirror_count" widget="statinfo" string="Tickets" />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Tickets (Community)" name="ticket_mirrors"
                      invisible="move_type != 'out_invoice'">
                    <field name="available_ticket_mirror_ids" invisible="1" />
                    <field name="ticket_mirror_ids" widget="many2many"
                           domain="[('id', 'in', available_ticket_mirror_ids)]">
                        <list create="0">
                            <field name="ticket_label" string="Ticket" />
                            <field name="partner_name" />
                            <field name="analytic_account_id" />
                            <field name="costo_total" sum="Total" />
                            <field name="billing_state" />
                            <field name="community_url" widget="url" string="Link Community" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
