<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="material_requisition_mirror_view_form" model="ir.ui.view">
        <field name="name">helpdesk.material.requisition.mirror.view.form</field>
        <field name="model">helpdesk.material.requisition.mirror</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Materiales (Community)" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_system" />
                            <field name="ticket_reference" />
                            <field name="team_name" />
                            <field name="requested_by_name" />
                        </group>
                        <group>
                            <field name="request_date" />
                            <field name="submit_date" />
                            <field name="received_date" />
                        </group>
                    </group>
                    <group string="Motivo" invisible="not reason">
                        <field name="reason" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="Líneas" name="lines">
                            <field name="line_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="product_name" />
                                    <field name="description" />
                                    <field name="qty" />
                                    <field name="uom_name" />
                                    <field name="requisition_type" />
                                    <field name="vendor_name" />
                                    <field name="estimated_price" />
                                    <field name="subtotal" sum="Total" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="material_requisition_mirror_view_list" model="ir.ui.view">
        <field name="name">helpdesk.material.requisition.mirror.view.list</field>
        <field name="model">helpdesk.material.requisition.mirror</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" />
                <field name="ticket_reference" />
                <field name="team_name" />
                <field name="requested_by_name" />
                <field name="submit_date" />
                <field name="received_date" />
                <field name="line_count" />
            </list>
        </field>
    </record>

    <record id="material_requisition_mirror_view_search" model="ir.ui.view">
        <field name="name">helpdesk.material.requisition.mirror.view.search</field>
        <field name="model">helpdesk.material.requisition.mirror</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="ticket_reference" />
                <field name="requested_by_name" />
                <field name="team_name" />
            </search>
        </field>
    </record>

    <record id="material_requisition_mirror_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de Materiales (Community)</field>
        <field name="res_model">helpdesk.material.requisition.mirror</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="materials_sync_root_menu" name="Materiales (Sync)" sequence="90" />
    <menuitem
        id="material_requisition_mirror_menu"
        name="Solicitudes Recibidas"
        parent="materials_sync_root_menu"
        action="material_requisition_mirror_action"
        sequence="10"
    />
</odoo>
