<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_construtec_face_attendance" model="ir.ui.view">
        <field name="name">hr.employee.form.construtec.face.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Reconocimiento Facial" groups="hr.group_hr_manager">
                    <div class="alert alert-info" role="alert">
                        Registrá las 3 fotos de referencia (frente, perfil izquierdo, perfil derecho) para
                        habilitar la verificación facial de este empleado al marcar asistencia desde su
                        propio teléfono. Mientras falte alguna, no va a poder fichar.
                    </div>
                    <field name="face_enrolled" invisible="1"/>
                    <field name="face_descriptor_front" invisible="1"/>
                    <field name="face_descriptor_left" invisible="1"/>
                    <field name="face_descriptor_right" invisible="1"/>
                    <div class="d-flex flex-wrap gap-4 mt16">
                        <div class="d-flex flex-column align-items-center">
                            <label for="face_image_front" string="Frente" class="fw-bold mb-2"/>
                            <field name="face_image_front" widget="construtec_face_capture"
                                   options="{'pose': 'Frente', 'descriptor_field': 'face_descriptor_front'}"/>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label for="face_image_left" string="Perfil Izquierdo" class="fw-bold mb-2"/>
                            <field name="face_image_left" widget="construtec_face_capture"
                                   options="{'pose': 'Perfil Izquierdo', 'descriptor_field': 'face_descriptor_left'}"/>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label for="face_image_right" string="Perfil Derecho" class="fw-bold mb-2"/>
                            <field name="face_image_right" widget="construtec_face_capture"
                                   options="{'pose': 'Perfil Derecho', 'descriptor_field': 'face_descriptor_right'}"/>
                        </div>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
