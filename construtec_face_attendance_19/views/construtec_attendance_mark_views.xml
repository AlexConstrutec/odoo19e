<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_construtec_attendance_mark_list" model="ir.ui.view">
        <field name="name">construtec.attendance.mark.list</field>
        <field name="model">construtec.attendance.mark</field>
        <field name="arch" type="xml">
            <list string="Marcajes de Asistencia" default_order="create_date desc">
                <field name="create_date" string="Fecha y Hora"/>
                <field name="employee_id"/>
                <field name="mark_type"/>
                <field name="analytic_account_id"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="maps_url" widget="url" text="Ver en mapa" string="Ubicación"/>
                <field name="observaciones" optional="hide"/>
                <field name="attendance_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_attendance_mark_search" model="ir.ui.view">
        <field name="name">construtec.attendance.mark.search</field>
        <field name="model">construtec.attendance.mark</field>
        <field name="arch" type="xml">
            <search string="Marcajes de Asistencia">
                <field name="employee_id"/>
                <field name="analytic_account_id"/>
                <filter string="Inicio de Labores / Hora Extra" name="filter_inicio_labores"
                        domain="[('mark_type', '=', 'inicio_labores')]"/>
                <filter string="Inicio de Alimentación" name="filter_inicio_alimentacion"
                        domain="[('mark_type', '=', 'inicio_alimentacion')]"/>
                <filter string="Fin de Alimentación" name="filter_fin_alimentacion"
                        domain="[('mark_type', '=', 'fin_alimentacion')]"/>
                <filter string="Fin de Labores / Hora Extra" name="filter_fin_labores"
                        domain="[('mark_type', '=', 'fin_labores')]"/>
                <separator/>
                <filter string="Hoy" name="filter_today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter string="Empleado" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Tipo de Marcaje" name="groupby_mark_type" context="{'group_by': 'mark_type'}"/>
                    <filter string="Fecha" name="groupby_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_construtec_attendance_mark_pivot" model="ir.ui.view">
        <field name="name">construtec.attendance.mark.pivot</field>
        <field name="model">construtec.attendance.mark</field>
        <field name="arch" type="xml">
            <pivot string="Marcajes de Asistencia">
                <field name="employee_id" type="row"/>
                <field name="mark_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_construtec_attendance_mark" model="ir.actions.act_window">
        <field name="name">Marcajes de Asistencia</field>
        <field name="res_model">construtec.attendance.mark</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_construtec_attendance_mark_search"/>
        <field name="context">{'search_default_filter_today': 0}</field>
    </record>

    <menuitem id="menu_construtec_attendance_mark"
              name="Marcajes de Asistencia"
              action="action_construtec_attendance_mark"
              parent="hr.menu_hr_root"
              groups="hr.group_hr_manager"
              sequence="96"/>
</odoo>
