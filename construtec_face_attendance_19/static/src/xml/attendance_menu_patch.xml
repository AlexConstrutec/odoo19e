<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<!-- Agrega el modal de verificación facial al widget "Check in/out" de la
     barra superior (hr_attendance), sin tocar el kiosco público. -->
<t t-inherit="hr_attendance.attendance_menu" t-inherit-mode="extension">
    <xpath expr="." position="inside">
        <div id="ConstrutecFaceModal" class="modal" role="dialog"
             style="z-index:1060; background:rgba(0,0,0,0.6); display:none;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="ConstrutecFaceModalTitle">Verificación Facial</h5>
                    </div>
                    <div class="modal-body text-center p-0"
                         style="position:relative;height:360px;overflow:hidden;background:#000;">
                        <video id="construtec_face_video" autoplay="autoplay" muted="muted"
                               playsinline="playsinline" webkit-playsinline="true"
                               style="width:100%;height:100%;object-fit:cover;"/>
                        <div id="ConstrutecFaceLiveDot"
                             class="d-flex align-items-center gap-1 text-white small"
                             style="display:none;position:absolute;top:8px;right:10px;background:rgba(0,0,0,0.55);
                                    padding:2px 8px;border-radius:12px;">
                            <span style="width:8px;height:8px;border-radius:50%;background:#e53935;
                                         animation:construtec-face-pulse 1.2s ease-in-out infinite;"/>
                            <span>Cámara activa</span>
                        </div>
                        <div id="ConstrutecFaceStatus" class="text-white small"
                             style="position:absolute;left:0;right:0;bottom:0;background:rgba(0,0,0,0.55);
                                    padding:6px 10px;">
                            Iniciando…
                        </div>
                    </div>
                    <style>
                        @keyframes construtec-face-pulse {
                            0%, 100% { opacity: 1; }
                            50% { opacity: 0.25; }
                        }
                    </style>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                t-on-click="() => this.onCancelFaceCheck()">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </xpath>

    <!-- Reemplaza el contenedor entero (info de horas + botón único
         Check in/out) por los 4 botones de marcaje + historial de 48hs. -->
    <xpath expr="//div[hasclass('o_att_menu_container')]" position="replace">
        <div class="o_att_menu_container d-flex flex-column gap-3" style="min-width:260px;">
            <div t-if="this.state.checkedIn and !this.isFirstAttendance" class="d-flex flex-wrap gap-3">
                <div t-if="!this.isFirstAttendance" class="att_container flex-grow-1 flex-shrink-0">
                    <small class="d-block text-muted">Before <t t-esc="this.lastCheckIn"/></small>
                    <div t-esc="this.hoursPreviouslyToday" class="fs-3 text-info text-end"/>
                </div>
                <div class="att_container flex-grow-1 flex-shrink-0">
                    <small class="d-block text-muted">Since <t t-esc="this.lastCheckIn"/></small>
                    <div t-esc="this.lastAttendanceWorkedHours" class="fs-3 text-info text-end"/>
                </div>
            </div>
            <div t-if="!this.isFirstAttendance" class="att_container d-flex flex-column p-2 bg-100 rounded">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-muted">Total today</small>
                    <h2 t-esc="this.hoursToday" class="mb-0 fs-4"/>
                </div>
            </div>

            <!-- Transparencia: mientras esté fichado, se le avisa que su
                 ubicación se sigue registrando de fondo cada 15 min (solo con
                 la app abierta y visible - no es un rastreo oculto). -->
            <div t-if="this.state.checkedIn" class="d-flex align-items-center gap-1 small text-success">
                <i class="fa fa-map-marker"/>
                <span>Ubicación automática activa mientras estés fichado</span>
            </div>

            <div class="d-flex flex-column gap-1">
                <label class="form-label small text-muted mb-0">Cuenta analítica (opcional)</label>
                <select id="ConstrutecAnalyticSelect" class="form-select form-select-sm">
                    <option value="">Sin cuenta asociada</option>
                    <option t-foreach="this.faceOptions.analyticAccounts" t-as="account" t-key="account.id"
                            t-att-value="account.id" t-esc="account.name"/>
                </select>
                <label class="form-label small text-muted mb-0 mt-1">Observaciones (opcional)</label>
                <textarea id="ConstrutecObservaciones" class="form-control form-control-sm" rows="2"/>
            </div>

            <div id="ConstrutecMarkButtons" class="d-flex flex-column gap-2">
                <button t-foreach="this.markButtons" t-as="markButton" t-key="markButton.markType"
                        type="button" t-attf-class="btn btn-{{ markButton.cls }} btn-sm text-start"
                        t-on-click="() => this.onMarkClick(markButton.markType)">
                    <i t-attf-class="fa {{ markButton.icon }} me-1"/>
                    <t t-esc="markButton.label"/>
                </button>
            </div>

            <div class="border-top pt-2">
                <small class="text-muted d-block mb-1">Tus marcajes (últimas 48hs)</small>
                <div style="max-height:160px;overflow-y:auto;">
                    <div t-if="!this.faceRecentMarks.items.length" class="text-muted small fst-italic">
                        Sin marcajes recientes.
                    </div>
                    <div t-foreach="this.faceRecentMarks.items" t-as="mark" t-key="mark.id"
                         class="d-flex justify-content-between small py-1 border-bottom">
                        <span t-esc="mark.label"/>
                        <span class="text-muted" t-esc="this.formatMarkDatetime(mark.datetime)"/>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
</t>

</templates>
