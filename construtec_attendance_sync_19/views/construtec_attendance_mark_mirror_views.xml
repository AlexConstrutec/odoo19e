<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_construtec_attendance_mark_mirror_list" model="ir.ui.view">
        <field name="name">construtec.attendance.mark.mirror.list</field>
        <field name="model">construtec.attendance.mark.mirror</field>
        <field name="arch" type="xml">
            <list string="Marcajes de Asistencia (Community)" default_order="received_date desc" create="0" edit="0">
                <field name="received_date" string="Fecha y Hora"/>
                <field name="employee_id"/>
                <field name="employee_name" optional="hide"/>
                <field name="mark_type"/>
                <field name="analytic_account_id"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="maps_url" widget="url" text="Ver en mapa" string="Ubicación"/>
                <field name="observaciones" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_attendance_mark_mirror_search" model="ir.ui.view">
        <field name="name">construtec.attendance.mark.mirror.search</field>
        <field name="model">construtec.attendance.mark.mirror</field>
        <field name="arch" type="xml">
            <search string="Marcajes de Asistencia (Community)">
                <field name="employee_id"/>
                <field name="employee_name"/>
                <field name="analytic_account_id"/>
                <group>
                    <filter string="Empleado" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Tipo de Marcaje" name="groupby_mark_type" context="{'group_by': 'mark_type'}"/>
                    <filter string="Fecha" name="groupby_date" context="{'group_by': 'received_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construtec_attendance_mark_mirror" model="ir.actions.act_window">
        <field name="name">Marcajes de Asistencia (Community)</field>
        <field name="res_model">construtec.attendance.mark.mirror</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_construtec_attendance_mark_mirror_search"/>
    </record>

    <menuitem id="menu_construtec_attendance_mark_mirror"
              name="Marcajes de Asistencia (Community)"
              action="action_construtec_attendance_mark_mirror"
              parent="hr.menu_hr_root"
              groups="hr.group_hr_manager"
              sequence="98"/>
</odoo>
