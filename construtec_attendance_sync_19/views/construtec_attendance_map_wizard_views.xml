<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_construtec_attendance_sync_map_wizard_form" model="ir.ui.view">
        <field name="name">construtec.attendance.sync.map.wizard.form</field>
        <field name="model">construtec.attendance.sync.map.wizard</field>
        <field name="arch" type="xml">
            <form string="Mapa de Marcajes (Community)">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="employee_ids" widget="many2many_tags" placeholder="Todos los colaboradores"/>
                </group>
                <footer>
                    <button string="Ver Mapa" type="object" name="action_view_map" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construtec_attendance_sync_map_wizard" model="ir.actions.act_window">
        <field name="name">Mapa de Marcajes (Community)</field>
        <field name="res_model">construtec.attendance.sync.map.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_construtec_attendance_sync_map_wizard"
              name="Mapa de Marcajes (Community)"
              action="action_construtec_attendance_sync_map_wizard"
              parent="hr.menu_hr_root"
              groups="hr.group_hr_manager"
              sequence="97"/>
</odoo>
