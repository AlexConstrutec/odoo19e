<odoo>
    <record id="view_construtec_audit_log_list" model="ir.ui.view">
        <field name="name">construtec.audit.log.list</field>
        <field name="model">construtec.audit.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc" create="0" edit="0" delete="0">
                <field name="create_date" string="Fecha"/>
                <field name="res_model"/>
                <field name="res_name"/>
                <field name="method"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_audit_log_form" model="ir.ui.view">
        <field name="name">construtec.audit.log.form</field>
        <field name="model">construtec.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_record" string="Abrir Registro" type="object"
                            class="oe_highlight" invisible="method == 'unlink'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="user_id"/>
                            <field name="create_date" string="Fecha"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="field_description"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construtec_audit_log_search" model="ir.ui.view">
        <field name="name">construtec.audit.log.search</field>
        <field name="model">construtec.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_model"/>
                <field name="res_name"/>
                <field name="user_id"/>
                <filter name="creaciones" string="Creación" domain="[('method', '=', 'create')]"/>
                <filter name="modificaciones" string="Modificación" domain="[('method', '=', 'write')]"/>
                <filter name="eliminaciones" string="Eliminación" domain="[('method', '=', 'unlink')]"/>
                <separator/>
                <group>
                    <filter name="group_model" string="Modelo" context="{'group_by': 'res_model'}"/>
                    <filter name="group_method" string="Operación" context="{'group_by': 'method'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construtec_audit_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Auditoría</field>
        <field name="res_model">construtec.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
