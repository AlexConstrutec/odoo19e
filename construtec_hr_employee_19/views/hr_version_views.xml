<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_payroll_gt" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.construtec.employee.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="inside">
                <field name="registrar_fecha_inspeccion"/>
                <field name="jornada_trabajo"/>
            </xpath>
        </field>
    </record>
</odoo>
