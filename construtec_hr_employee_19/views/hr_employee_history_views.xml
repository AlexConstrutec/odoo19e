<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_history_job_salary_form" model="ir.ui.view">
        <field name="name">hr.employee.history.job.salary.form</field>
        <field name="model">hr.employee.history.job.salary</field>
        <field name="arch" type="xml">
            <form string="Record Laboral">
                <group>
                    <field name="identification_employee_id" required="1"/>
                    <field name="employee" required="1"/>
                    <field name="date_start" required="1"/>
                    <field name="date_end"/>
                    <field name="company" required="1"/>
                    <field name="job" required="1"/>
                    <field name="salary" required="1"/>
                </group>
                <footer>
                    <button string="Guardar" class="btn-primary" special="save"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_history_job_salary" model="ir.actions.act_window">
        <field name="name">Historial de puestos</field>
        <field name="res_model">hr.employee.history.job.salary</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_employee_history_job_salary_form"/>
        <field name="target">new</field>
    </record>
</odoo>
