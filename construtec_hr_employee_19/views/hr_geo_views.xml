<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ocupacion_puesto_list" model="ir.ui.view">
        <field name="name">hr.ocupacion.puesto.list</field>
        <field name="model">hr.ocupacion.puesto</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_ocupacion_puesto" model="ir.actions.act_window">
        <field name="name">Ocupaciones de Puesto</field>
        <field name="res_model">hr.ocupacion.puesto</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ocupacion_puesto" name="Ocupación de Puesto" parent="hr.menu_config_employee" action="action_ocupacion_puesto"/>
</odoo>
