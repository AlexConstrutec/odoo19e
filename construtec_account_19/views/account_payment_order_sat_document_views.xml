<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión Enterprise-only de la vista compartida (construtec_account_payment_order_19)
         - agrega una pestaña nueva "Documentos SAT" mostrando qué Documentos SAT eligió el jefe
         de técnicos en Community para una Solicitud de Pago Directo, incluyendo los que todavía
         siguen Pendientes de convertir a factura (invisibles hasta ahora: factura_ids solo
         refleja account.move reales, y un Documento SAT Pendiente no tiene move_id todavía - ver
         sat_document_ids/_compute_sat_document_ids en account_payment_order_sat_document.py).
         Vive aquí, no en el archivo compartido, por la misma razón de siempre: ese modelo no
         existe en Community.

         `cuenta_contable_id`/`cuenta_analitica_id` son editables (y editables en masa, vía la
         selección múltiple nativa de una lista `editable=` - Odoo pregunta "¿Aplicar a los N
         registros seleccionados?" y hace un solo write() sobre construtec.sat.document, nunca
         sobre este campo compute) SOLO mientras el documento sigue Pendiente - es justo lo que
         sat_document.write() ya usa para rellenar line_ids.account_id de las líneas que aún no
         tengan cuenta propia (ver sat_document.py), y lo que action_convertir_a_factura() exige
         antes de convertir. Editar un documento ya Convertido a Factura aquí no tendría ningún
         efecto útil (sus líneas de factura ya están resueltas), así que queda de solo lectura. -->
    <record id="view_account_payment_order_form_sat_document" model="ir.ui.view">
        <field name="name">account.payment.order.form.sat.document</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="construtec_account_payment_order_19.view_account_payment_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='facturas_y_pagos']" position="before">
                <page string="Documentos SAT" invisible="tipo != 'pago_directo'">
                    <field name="sat_document_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="numero_autorizacion" string="No. Autorización" readonly="1"/>
                            <field name="partner_id" string="Proveedor" readonly="1"/>
                            <field name="fecha_certificacion" string="Fecha" readonly="1"/>
                            <field name="monto_total" string="Monto" readonly="1"/>
                            <field name="cuenta_contable_id" string="Cuenta Contable"
                                   readonly="state != 'pendiente'"/>
                            <field name="cuenta_analitica_id" string="Cuenta Analítica"
                                   readonly="state != 'pendiente'"/>
                            <field name="state" string="Estado del Documento SAT" widget="badge"
                                   readonly="1"
                                   decoration-warning="state == 'pendiente'"
                                   decoration-success="state == 'convertido_factura'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
