<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construtec_sat_document_form" model="ir.ui.view">
        <field name="name">construtec.sat.document.form</field>
        <field name="model">construtec.sat.document</field>
        <field name="arch" type="xml">
            <form string="Documento SAT">
                <header>
                    <button name="action_convertir_a_factura" string="Convertir a Factura" type="object"
                            class="oe_highlight" invisible="state != 'pendiente'"/>
                    <button name="action_convertir_a_orden_compra" string="Convertir a Orden de Compra" type="object"
                            invisible="state != 'pendiente' or direction != 'recibida'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pendiente,convertido_factura,convertido_orden_compra"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not anulado">
                        Este documento fue <strong>ANULADO</strong> en la SAT
                        (<field name="fecha_anulacion" readonly="1" nolabel="1"/>).
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_factura" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not move_id">
                            <field name="move_id" widget="statinfo" string="Factura"/>
                        </button>
                        <button name="action_ver_orden_compra" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="not purchase_order_id">
                            <field name="purchase_order_id" widget="statinfo" string="Orden de Compra"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="numero_autorizacion"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="tipo_dte"/>
                            <field name="serie"/>
                            <field name="numero_documento"/>
                            <field name="fecha_certificacion"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="nit_emisor" readonly="1"/>
                            <field name="nombre_emisor" readonly="1"/>
                            <field name="nit_receptor" readonly="1"/>
                            <field name="nombre_receptor" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="monto_total"/>
                            <field name="monto_iva"/>
                        </group>
                        <group>
                            <field name="xml_attachment_id" readonly="1"/>
                            <field name="pdf_attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="numero_linea" optional="hide"/>
                                    <field name="bien_o_servicio" optional="hide"/>
                                    <field name="descripcion"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="monto_descuento"/>
                                    <field name="otro_descuento" optional="hide"/>
                                    <field name="monto_iva"/>
                                    <field name="monto_total" sum="Total"/>
                                    <field name="product_id"/>
                                    <field name="account_id"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Detalle SAT">
                            <group>
                                <group string="Emisor">
                                    <field name="nombre_comercial_emisor"/>
                                    <field name="direccion_emisor"/>
                                    <field name="codigo_establecimiento"/>
                                    <field name="nombre_establecimiento"/>
                                    <field name="clasificacion_emisor"/>
                                    <field name="exportacion"/>
                                </group>
                                <group string="Certificación / Estado">
                                    <field name="nit_certificador"/>
                                    <field name="nombre_certificador"/>
                                    <field name="moneda_codigo"/>
                                    <field name="estado_sat"/>
                                    <field name="anulado"/>
                                    <field name="fecha_anulacion" invisible="not anulado"/>
                                </group>
                            </group>
                            <group string="Otros Impuestos (si aplica)">
                                <group>
                                    <field name="monto_petroleo"/>
                                    <field name="monto_turismo_hospedaje"/>
                                    <field name="monto_turismo_pasajes"/>
                                    <field name="monto_timbre_prensa"/>
                                </group>
                                <group>
                                    <field name="monto_bomberos"/>
                                    <field name="monto_tasa_municipal"/>
                                    <field name="monto_bebidas_alcoholicas"/>
                                    <field name="monto_tabaco"/>
                                </group>
                                <group>
                                    <field name="monto_cemento"/>
                                    <field name="monto_bebidas_no_alcoholicas"/>
                                    <field name="monto_tarifa_portuaria"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construtec_sat_document_list" model="ir.ui.view">
        <field name="name">construtec.sat.document.list</field>
        <field name="model">construtec.sat.document</field>
        <field name="arch" type="xml">
            <list string="Documentos SAT" decoration-danger="anulado">
                <field name="partner_id"/>
                <field name="nit_contacto"/>
                <field name="fecha_certificacion"/>
                <field name="direction"/>
                <field name="tipo_dte"/>
                <field name="numero_autorizacion"/>
                <field name="monto_total" sum="Total"/>
                <field name="anulado" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('convertido_factura', 'convertido_orden_compra')"
                       decoration-info="state == 'pendiente'"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_sat_document_search" model="ir.ui.view">
        <field name="name">construtec.sat.document.search</field>
        <field name="model">construtec.sat.document</field>
        <field name="arch" type="xml">
            <search string="Documentos SAT">
                <field name="numero_autorizacion"/>
                <field name="partner_id"/>
                <filter string="Recibidas" name="recibidas" domain="[('direction', '=', 'recibida')]"/>
                <filter string="Emitidas" name="emitidas" domain="[('direction', '=', 'emitida')]"/>
                <separator/>
                <filter string="Pendientes" name="pendientes" domain="[('state', '=', 'pendiente')]"/>
                <filter string="Convertidos" name="convertidos"
                        domain="[('state', 'in', ('convertido_factura', 'convertido_orden_compra'))]"/>
                <filter string="Anuladas" name="anuladas" domain="[('anulado', '=', True)]"/>
                <group>
                    <filter string="Dirección" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construtec_sat_document" model="ir.actions.act_window">
        <field name="name">Documentos SAT</field>
        <field name="res_model">construtec.sat.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pendientes': 1}</field>
    </record>

    <record id="view_construtec_sat_document_line_detail_list" model="ir.ui.view">
        <field name="name">construtec.sat.document.line.detail.list</field>
        <field name="model">construtec.sat.document.line</field>
        <field name="arch" type="xml">
            <list string="Detalle de Facturas SAT" create="0" edit="0">
                <field name="numero_autorizacion"/>
                <field name="partner_id"/>
                <field name="nit_contacto"/>
                <field name="fecha_certificacion"/>
                <field name="product_id"/>
                <field name="descripcion"/>
                <field name="cantidad"/>
                <field name="precio_unitario"/>
                <field name="monto_iva" sum="IVA"/>
                <field name="monto_total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_sat_document_line_detail_search" model="ir.ui.view">
        <field name="name">construtec.sat.document.line.detail.search</field>
        <field name="model">construtec.sat.document.line</field>
        <field name="arch" type="xml">
            <search string="Detalle de Facturas SAT">
                <field name="numero_autorizacion"/>
                <field name="partner_id"/>
                <field name="nit_contacto"/>
                <field name="product_id"/>
                <group>
                    <filter string="Contacto" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construtec_sat_document_line_detail" model="ir.actions.act_window">
        <field name="name">Detalle de Facturas SAT</field>
        <field name="res_model">construtec.sat.document.line</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_construtec_sat_document_import" model="ir.actions.server">
        <field name="name">Importar desde SAT</field>
        <field name="model_id" ref="model_construtec_sat_document"/>
        <field name="state">code</field>
        <field name="code">action = model.action_import_from_outbox()</field>
    </record>

    <menuitem id="menu_construtec_sat_document_root" name="Documentos SAT" parent="account.menu_finance"
              sequence="6"/>
    <menuitem id="menu_construtec_sat_document" action="action_construtec_sat_document"
              parent="menu_construtec_sat_document_root" sequence="1"/>
    <menuitem id="menu_construtec_sat_document_line_detail" action="action_construtec_sat_document_line_detail"
              parent="menu_construtec_sat_document_root" sequence="2"/>
    <menuitem id="menu_construtec_sat_document_import" action="action_construtec_sat_document_import"
              parent="menu_construtec_sat_document_root" sequence="3"/>
</odoo>
