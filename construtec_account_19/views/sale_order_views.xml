<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_construtec_account" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.construtec.account</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sat_document" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not sat_document_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Documento SAT</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
