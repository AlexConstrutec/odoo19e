<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_hr_loan_multi_company" model="ir.rule">
            <field name="name">Préstamos: multi-compañía</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hr_loan_own" model="ir.rule">
            <field name="name">Préstamos: solo propios</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hr_loan_hr_all" model="ir.rule">
            <field name="name">Préstamos: RRHH ve todos</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="rule_salary_advance_own" model="ir.rule">
            <field name="name">Anticipos: solo propios</field>
            <field name="model_id" ref="model_salary_advance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_salary_advance_hr_account_all" model="ir.rule">
            <field name="name">Anticipos: RRHH y Contabilidad ven todos</field>
            <field name="model_id" ref="model_salary_advance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>
