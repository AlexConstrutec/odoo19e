<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.construtec.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="inside">
                <field name="tiempo_contrato"/>
                <field name="estado_contrato"/>
                <field name="frecuencia_pago"/>
                <field name="empresa_facturar"/>
                <field name="bonificacion_fija"/>
                <field name="bonificacion_incentivo"/>
                <field name="bonificacion_productividad"/>
                <field name="horas_extra_valor"/>
            </xpath>
        </field>
    </record>
</odoo>
