<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.construtec.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_type']" position="before">
                <field name="x_bonificacion_incentivo"/>
                <field name="x_bonificacion_productividad"/>
            </xpath>
            <xpath expr="//group[@name='contract']" position="inside">
                <field name="x_bonificacion_fija"/>
                <field name="x_bonificacion_extra"/>
                <field name="x_horas_extra_valor"/>
            </xpath>
        </field>
    </record>
</odoo>
