<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_loan_list_view" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de préstamo">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_amount"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_loan_line_list_view" model="ir.ui.view">
        <field name="name">hr.loan.line.list</field>
        <field name="model">hr.loan.line</field>
        <field name="arch" type="xml">
            <list string="Pagos de préstamo">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="version_id"/>
                <field name="loan_id"/>
                <field name="paid"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="hr_loan_form_view" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Préstamo">
                <header>
                    <button name="compute_installment" type="object" string="Calcular Pagos" class="oe_highlight" invisible="state in ('approve', 'refuse')"/>
                    <button name="action_submit" type="object" string="Confirmar" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprobar" invisible="state != 'waiting_approval_1'" class="oe_highlight" groups="hr.group_hr_manager"/>
                    <button name="action_refuse" type="object" string="Rechazar" invisible="state not in ('draft', 'waiting_approval_1', 'approve')" class="oe_highlight" groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval_1,approve"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group col="4">
                        <field name="employee_id" readonly="state == 'approve'"/>
                        <field name="version_id"/>
                        <field name="version_is_current"/>
                        <field name="dpi"/>
                        <field name="date"/>
                        <field name="department_id"/>
                        <field name="job_position"/>
                        <field name="concepto" readonly="state != 'draft'"/>
                        <field name="loan_amount" readonly="state == 'approve'"/>
                        <field name="installment" readonly="state == 'approve'"/>
                        <field name="payment_date" readonly="state == 'approve'"/>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="reason" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Calendario de Pagos">
                            <field name="loan_lines">
                                <list string="Cuotas" editable="bottom">
                                    <field name="version_id"/>
                                    <field name="version_is_current"/>
                                    <field name="date" readonly="paid and state == 'approve'"/>
                                    <field name="amount" readonly="paid and state == 'approve'"/>
                                    <field name="paid" readonly="1"/>
                                    <field name="state" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_paid_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="balance_amount" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_loan_request_search_form" model="ir.ui.view">
        <field name="name">hr.loan.search.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Préstamos">
                <filter string="Mis Préstamos" name="myrequest" domain="[('employee_id.user_id.id', '=', uid)]"/>
                <field name="employee_id" string="Empleado"/>
                <field name="department_id" string="Departamento"/>
                <filter string="Empleado" name="employee_id" context="{'group_by':'employee_id'}"/>
                <filter string="Departamento" name="department_id" context="{'group_by':'department_id'}"/>
                <filter string="Estado" name="status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_loan_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Préstamo</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_myrequest': 1}</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una solicitud de préstamo.
            </p>
        </field>
    </record>

    <record id="act_hr_loan_line_request" model="ir.actions.act_window">
        <field name="name">Pagos de Préstamo</field>
        <field name="res_model">hr.loan.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_loan_line_list_view"/>
    </record>

    <record id="act_hr_employee_loan_request" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">form</field>
        <field name="view_id" ref="hr_loan_list_view"/>
    </record>

    <record id="view_employee_form_loan_inherit" model="ir.ui.view">
        <field name="name">hr.employee.loan.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(act_hr_employee_loan_request)d" type="action" class="oe_stat_button" icon="fa-calendar" groups="hr.group_hr_manager,hr.group_hr_user">
                    <field name="loan_count" widget="statinfo" string="Préstamos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
