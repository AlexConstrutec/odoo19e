<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_advance_form" model="ir.ui.view">
        <field name="name">salary.advance.form</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <form string="Anticipo">
                <header>
                    <button name="action_approve" string="Aprobar" type="object" invisible="state != 'draft'" class="oe_highlight" groups="hr.group_hr_manager,account.group_account_manager"/>
                    <button name="action_set_draft" string="Borrador" type="object" invisible="state not in ('approve', 'reject')" groups="hr.group_hr_manager,account.group_account_manager"/>
                    <button name="action_set_cobrado" string="Cobrado" type="object" invisible="state not in ('draft', 'approve')" groups="hr.group_hr_manager,account.group_account_manager"/>
                    <button name="action_reject" string="Rechazar" type="object" invisible="state not in ('draft', 'approve')" groups="hr.group_hr_manager,account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approve,cobrado,reject"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="dpi" readonly="state != 'draft'"/>
                            <field name="department" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="exceed_condition" invisible="1" groups="hr.group_hr_manager,hr.group_hr_user"/>
                            <field name="tipo_anticipo" readonly="state != 'draft'"/>
                            <field name="concepto" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="advance" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'" groups="base.group_multi_currency"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="cheque" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="version_id"/>
                            <field name="version_is_current"/>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_salary_advance_list" model="ir.ui.view">
        <field name="name">salary.advance.list</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <list string="Anticipos">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="advance"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_salary_advance_filter" model="ir.ui.view">
        <field name="name">salary.advance.select</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name" string="Anticipo" filter_domain="[('name', 'ilike', self)]"/>
                <field name="employee_id"/>
                <field name="state"/>
                <filter string="Mis solicitudes" domain="[('employee_id.user_id.id', '=', uid)]" name="my_requests_filter"/>
                <filter domain="[('state', '=', 'draft')]" string="Borrador" name="to_report"/>
                <filter domain="[('state', '=', 'approve')]" string="Aprobado" name="approved"/>
                <separator/>
                <filter string="Empleado" name="employee_id" domain="[]" context="{'group_by':'employee_id'}"/>
                <filter name="state_group" string="Estado" domain="[]" context="{'group_by':'state'}"/>
                <filter string="Fecha" domain="[]" name="date" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_salary_advance" model="ir.actions.act_window">
        <field name="name">Anticipos</field>
        <field name="res_model">salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_salary_advance_filter"/>
        <field name="context">{'search_default_to_report': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un anticipo.
            </p>
        </field>
    </record>
</odoo>
