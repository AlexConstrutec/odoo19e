<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_construtec" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construtec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']" position="after">
                <page string="Nóminas Pagadas" invisible="not slip_ids">
                    <field name="slip_ids" readonly="1">
                        <list string="Nóminas">
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="payslip_run_id"/>
                            <field name="basic_wage"/>
                            <field name="net_wage"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
