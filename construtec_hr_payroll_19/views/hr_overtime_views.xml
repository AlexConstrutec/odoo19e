<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_overtime_shift_list_view" model="ir.ui.view">
        <field name="name">hr.overtime.shift.list</field>
        <field name="model">hr.overtime.shift</field>
        <field name="arch" type="xml">
            <list string="Jornadas de Hora Extra" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_overtime_shift" model="ir.actions.act_window">
        <field name="name">Jornadas de Hora Extra</field>
        <field name="res_model">hr.overtime.shift</field>
        <field name="view_mode">list</field>
    </record>

    <record id="hr_overtime_list_view" model="ir.ui.view">
        <field name="name">hr.overtime.list</field>
        <field name="model">hr.overtime</field>
        <field name="arch" type="xml">
            <list string="Horas Extra" editable="bottom">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="rate_id" domain="[('employee_id', '=', employee_id)]" options="{'no_create': True, 'no_open': True}"/>
                <field name="number_of_hours"/>
                <field name="unit_amount" readonly="1"/>
                <field name="total_amount" readonly="1" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_hr_overtime_search" model="ir.ui.view">
        <field name="name">hr.overtime.search</field>
        <field name="model">hr.overtime</field>
        <field name="arch" type="xml">
            <search string="Horas Extra">
                <field name="employee_id"/>
                <filter string="Empleado" name="group_employee" context="{'group_by':'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_overtime" model="ir.actions.act_window">
        <field name="name">Horas Extra</field>
        <field name="res_model">hr.overtime</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_overtime_list_view"/>
        <field name="search_view_id" ref="view_hr_overtime_search"/>
    </record>

    <record id="view_employee_form_overtime_inherit" model="ir.ui.view">
        <field name="name">hr.employee.overtime.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Horas Extra" name="overtime">
                    <group col="2">
                        <field name="overtime_ids" nolabel="1">
                            <list string="Horas Extras" editable="bottom">
                                <field name="employee_id" column_invisible="1"/>
                                <field name="date"/>
                                <field name="rate_id" domain="[('employee_id', '=', employee_id)]" options="{'no_create': True, 'no_open': True}"/>
                                <field name="number_of_hours"/>
                                <field name="unit_amount" readonly="1"/>
                                <field name="total_amount" readonly="1" sum="Total"/>
                            </list>
                        </field>
                        <field name="overtime_rate_ids" nolabel="1">
                            <list string="Tipo Hora Extra" editable="bottom">
                                <field name="shift_id"/>
                                <field name="hourly_amount"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
