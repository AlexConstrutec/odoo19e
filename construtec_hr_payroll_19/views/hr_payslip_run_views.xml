<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_kanban_inherit_construtec" model="ir.ui.view">
        <field name="name">hr.payslip.run.kanban.inherit.construtec</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_confirm_and_validate" type="object" class="btn oe_highlight"
                        string="Confirmar Nóminas"
                        invisible="state != '01_ready' or empty_payslips &gt; 0 or payslip_count == 0"/>
                <button name="%(action_hr_payslip_worked_days_import_wizard)d" type="action" class="btn btn-secondary"
                        string="Importar XLSX" invisible="state != '01_ready'"
                        context="{'default_payslip_run_id': id}"/>
                <button name="%(action_hr_payslip_batchwise_register_payment_wizard)d" type="action" class="btn btn-secondary"
                        string="Generar Pagos" invisible="state != '02_close'"
                        context="{'default_batch_id': id}"/>
            </xpath>
        </field>
    </record>
</odoo>
