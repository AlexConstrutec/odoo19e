<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_qualification_form" model="ir.ui.view">
        <field name="name">hr.qualification.form</field>
        <field name="model">hr.qualification</field>
        <field name="arch" type="xml">
            <form string="Calificación">
                <header>
                    <button name="approve" string="Aprobar" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="set_draft" string="Borrador" type="object" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id" readonly="state == 'done'"/>
                            <field name="fecha_evaluacion" readonly="state == 'done'"/>
                            <field name="version_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="calificacion" readonly="state == 'done'" widget="percentage"/>
                            <field name="bonificacion" readonly="1"/>
                            <field name="total" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_qualification_list" model="ir.ui.view">
        <field name="name">hr.qualification.list</field>
        <field name="model">hr.qualification</field>
        <field name="arch" type="xml">
            <list string="Calificaciones">
                <field name="employee_id"/>
                <field name="fecha_evaluacion"/>
                <field name="state"/>
                <field name="calificacion" widget="percentage"/>
                <field name="bonificacion"/>
                <field name="total"/>
            </list>
        </field>
    </record>

    <record id="view_hr_qualification_filter" model="ir.ui.view">
        <field name="name">hr.qualification.select</field>
        <field name="model">hr.qualification</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="employee_id"/>
                <field name="fecha_evaluacion"/>
                <separator/>
                <filter string="Empleado" name="employee_id" context="{'group_by':'employee_id'}"/>
                <filter string="Estado" name="state" context="{'group_by':'state'}"/>
                <filter string="Fecha Evaluación" name="fecha_evaluacion" context="{'group_by':'fecha_evaluacion'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_qualification" model="ir.actions.act_window">
        <field name="name">Calificaciones</field>
        <field name="res_model">hr.qualification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
