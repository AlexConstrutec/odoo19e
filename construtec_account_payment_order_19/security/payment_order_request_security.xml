<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payment_order_approver" model="res.groups">
        <field name="name">Solicitudes de Pago: Aprobador</field>
        <field name="comment">Puede aprobar o rechazar Solicitudes de Pago (Viáticos, Materiales, etc.).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payment_order_sync_integration" model="res.groups">
        <field name="name">Solicitudes de Pago: Integración (solo creación)</field>
        <field name="comment">Grupo para el usuario técnico de integración que sincroniza Solicitudes de
            Pago desde una instalación Solicitante. Solo puede crear registros, nunca leer, modificar
            ni eliminar - una API Key filtrada de este usuario solo permite insertar solicitudes, no
            acceder a datos existentes.</field>
    </record>

    <record id="account_payment_order_request_own_rule" model="ir.rule">
        <field name="name">Solicitud de Pago: el solicitante ve las propias</field>
        <field name="model_id" ref="model_account_payment_order_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="account_payment_order_request_approver_rule" model="ir.rule">
        <field name="name">Solicitud de Pago: el Aprobador ve todas</field>
        <field name="model_id" ref="model_account_payment_order_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_order_approver')),
                                    (4, ref('account.group_account_invoice')),
                                    (4, ref('group_payment_order_sync_integration'))]"/>
    </record>

    <record id="account_payment_order_request_company_rule" model="ir.rule">
        <field name="name">Solicitud de Pago: Regla de Compañía</field>
        <field name="model_id" ref="model_account_payment_order_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
