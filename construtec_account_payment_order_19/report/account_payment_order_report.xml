<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_account_payment_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2><span t-field="o.name"/></h2>

                        <div class="row mt32 mb32">
                            <div class="col-4">
                                <strong>Fecha:</strong><br/>
                                <span t-field="o.fecha"/>
                            </div>
                            <div class="col-4">
                                <strong>Diario:</strong><br/>
                                <span t-field="o.journal_id.name"/>
                            </div>
                            <div class="col-4">
                                <strong>Asiento:</strong><br/>
                                <span t-field="o.move_id.name"/>
                            </div>
                        </div>

                        <h3>Facturas</h3>
                        <t t-set="total_factura" t-value="0"/>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th><strong>No. Interno</strong></th>
                                    <th><strong>No. Proveedor</strong></th>
                                    <th><strong>Proveedor</strong></th>
                                    <th class="text-end"><strong>Valor</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.factura_ids" t-as="f">
                                    <t t-set="total_factura" t-value="total_factura + f.amount_total"/>
                                    <td><span t-field="f.name"/></td>
                                    <td><span t-field="f.ref"/></td>
                                    <td><span t-field="f.partner_id.name"/></td>
                                    <td class="text-end">
                                        <span t-field="f.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": f.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">Total</td>
                                    <td class="text-end">
                                        <span t-esc="total_factura"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Pagos/Cheques</h3>
                        <t t-set="total_pago" t-value="0"/>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th><strong>No. Interno</strong></th>
                                    <th><strong>Memo</strong></th>
                                    <th><strong>Contacto</strong></th>
                                    <th class="text-end"><strong>Valor</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.pago_ids" t-as="c">
                                    <t t-set="total_pago" t-value="total_pago + c.amount"/>
                                    <td><span t-field="c.name"/></td>
                                    <td><span t-field="c.memo"/></td>
                                    <td><span t-field="c.partner_id.name"/></td>
                                    <td class="text-end">
                                        <span t-field="c.amount"
                                              t-options='{"widget": "monetary", "display_currency": c.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">Total</td>
                                    <td class="text-end">
                                        <span t-esc="total_pago"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td>Diferencia</td>
                                    <td class="text-end">
                                        <span t-esc="total_factura - total_pago"
                                              t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_account_payment_order" model="ir.actions.report">
        <field name="name">Orden de Pago</field>
        <field name="model">account.payment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construtec_account_payment_order_19.report_account_payment_order_document</field>
        <field name="report_file">construtec_account_payment_order_19.report_account_payment_order_document</field>
        <field name="print_report_name">'Orden de Pago - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_account_payment_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
