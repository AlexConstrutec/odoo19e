<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_order_request_crear_anticipo_form" model="ir.ui.view">
        <field name="name">account.payment.order.request.crear.anticipo.wizard.form</field>
        <field name="model">account.payment.order.request.crear.anticipo.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Anticipo">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="partner_id"/>
                    <field name="journal_id"/>
                    <field name="available_payment_method_line_ids" invisible="1"/>
                    <field name="payment_method_line_id"/>
                    <field name="cuenta_anticipo_id"/>
                    <field name="monto"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Crear Anticipo" type="object" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
