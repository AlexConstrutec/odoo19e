<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_payment_order" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.payment.order</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="no_liquidacion" options="{'no_create': True}"/>
                <field name="payment_order_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
