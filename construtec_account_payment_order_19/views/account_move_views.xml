<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_payment_order" model="ir.ui.view">
        <field name="name">account.move.form.inherit.payment.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="no_liquidacion" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="payment_order_id" invisible="move_type not in ('in_invoice', 'in_refund')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
