<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_payment_order" model="ir.ui.view">
        <field name="name">account.move.form.inherit.payment.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- En "Otra información" en vez del encabezado (pedido del usuario 2026-10-13). -->
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string="Requisición de Pago" name="payment_order_group"
                       invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="payment_order_id" string="Requisición de Pago"
                           options="{'no_create': True}"/>
                    <field name="payment_order_ids" string="Historial de Requisiciones"
                           widget="many2many_tags" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
