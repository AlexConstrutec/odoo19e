<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_order_request_form" model="ir.ui.view">
        <field name="name">account.payment.order.request.form</field>
        <field name="model">account.payment.order.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Pago">
                <header>
                    <button name="action_submit" string="Enviar" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar" type="object" class="oe_highlight"
                            groups="construtec_account_payment_order_19.group_payment_order_approver"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            groups="construtec_account_payment_order_19.group_payment_order_approver"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" string="Volver a Borrador" type="object"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('cancel', 'rejected')"/>
                    <button name="action_crear_anticipo" string="Crear Anticipo" type="object"
                            class="oe_highlight" groups="account.group_account_invoice"
                            invisible="state != 'approved' or payment_order_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_order" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not payment_order_id">
                            <field name="payment_order_id" widget="statinfo" string="Orden de Pago"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="justificacion_tipo"/>
                            <field name="employee_id"/>
                            <field name="requested_by_name"/>
                            <field name="puesto"/>
                            <field name="departamento"/>
                            <field name="analytic_account_id"/>
                            <field name="proyecto" invisible="1"/>
                            <field name="telefono"/>
                            <field name="correo"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="cuenta_acreditar"/>
                            <field name="tipo_cuenta"/>
                            <field name="banco"/>
                            <field name="periodo_del"/>
                            <field name="periodo_al"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Viáticos" invisible="justificacion_tipo != 'viaticos'">
                            <field name="viaticos_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id" optional="show"/>
                                    <field name="tecnico_name"/>
                                    <field name="departamento" optional="show"/>
                                    <field name="puesto" optional="show"/>
                                    <field name="rubro"/>
                                    <field name="cantidad"/>
                                    <field name="costo_individual"/>
                                    <field name="total" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal"/>
                                <field name="anticipo_previo" readonly="state != 'draft'"/>
                                <field name="total_acreditar" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Sincronización" invisible="origin == 'synced' and not external_ref">
                            <group>
                                <field name="origin"/>
                                <field name="external_ref" invisible="not external_ref"/>
                                <field name="sync_state" invisible="origin == 'synced'"/>
                                <field name="sync_error" invisible="sync_state != 'error'"/>
                                <field name="sync_date" invisible="not sync_date"/>
                            </group>
                            <button name="action_retry_sync" string="Reintentar Sincronización" type="object"
                                    invisible="sync_state != 'error'"/>
                        </page>
                    </notebook>
                    <group>
                        <field name="observaciones"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_payment_order_request_list" model="ir.ui.view">
        <field name="name">account.payment.order.request.list</field>
        <field name="model">account.payment.order.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Pago">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requested_by_name"/>
                <field name="justificacion_tipo"/>
                <field name="total_acreditar" sum="Total"/>
                <field name="origin"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_account_payment_order_request_search" model="ir.ui.view">
        <field name="name">account.payment.order.request.search</field>
        <field name="model">account.payment.order.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de Pago">
                <field name="name"/>
                <field name="requested_by_name"/>
                <filter string="Mis Solicitudes" name="my_requests" domain="[('requested_by_id', '=', uid)]"/>
                <filter string="Pendientes de Aprobar" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Aprobadas" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_payment_order_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Pago</field>
        <field name="res_model">account.payment.order.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una Solicitud de Pago.</p>
        </field>
    </record>

    <menuitem action="action_account_payment_order_request" id="menu_account_payment_order_request"
              parent="account.menu_finance_payables" sequence="20"/>
</odoo>
