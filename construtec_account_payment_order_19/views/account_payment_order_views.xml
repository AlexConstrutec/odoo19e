<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_order_form" model="ir.ui.view">
        <field name="name">account.payment.order.form</field>
        <field name="model">account.payment.order</field>
        <field name="arch" type="xml">
            <form string="Requisición de Pago">
                <header>
                    <button name="action_submit" string="Enviar" type="object" class="oe_highlight"
                            invisible="tipo not in ('anticipo', 'anticipo_materiales', 'pago_directo') or state != 'borrador' or (tipo == 'pago_directo' and es_procesador)"/>
                    <button name="action_submit_depositar_a_mi" string="Depositar a Mí" type="object"
                            class="oe_highlight"
                            invisible="tipo != 'anticipo_viaticos' or state != 'borrador' or orden_padre_id"/>
                    <button name="action_submit_depositar_a_tecnicos" string="Depositar a Técnicos"
                            type="object" class="oe_highlight"
                            invisible="tipo != 'anticipo_viaticos' or state != 'borrador' or orden_padre_id"/>
                    <button name="action_approve" string="Aprobar" type="object" class="oe_highlight"
                            groups="construtec_account_payment_order_19.group_payment_order_approver"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state != 'enviado' or not es_procesador"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            groups="construtec_account_payment_order_19.group_payment_order_approver"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state not in ('enviado', 'en_compras') or not es_procesador"/>
                    <button name="action_reset_to_draft" string="Volver a Borrador" type="object"
                            groups="construtec_account_payment_order_19.group_payment_order_approver"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state != 'enviado' or not es_procesador"/>
                    <button name="action_reset_to_draft" string="Volver a Borrador" type="object"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state != 'rechazado'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state in ('cancelado', 'rechazado', 'aplicado', 'liquidado', 'dividida')"/>
                    <button name="action_aplicar" string="Aplicar" type="object" class="oe_highlight"
                            groups="account.group_account_manager"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales') or state != 'aprobado' or not es_procesador"/>
                    <button name="action_cancelar_anticipo_aplicado" string="Cancelar" type="object"
                            groups="account.group_account_manager"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales') or state != 'aplicado' or not es_procesador"/>
                    <button name="action_generar_orden_compra" string="Generar Orden de Compra" type="object"
                            groups="purchase.group_purchase_user,account.group_account_manager"
                            invisible="tipo != 'anticipo_materiales' or state not in ('en_compras', 'aprobado', 'aplicado') or not es_procesador"/>
                    <!-- Un clic: genera la Orden de Compra si hace falta y muestra su PDF para enviarlo al
                         proveedor (2026-10-17). -->
                    <button name="action_imprimir_orden_compra" string="Imprimir Orden de Compra" type="object"
                            icon="fa-print" groups="purchase.group_purchase_user,account.group_account_manager"
                            invisible="tipo != 'anticipo_materiales' or state not in ('en_compras', 'aprobado', 'aplicado') or not es_procesador"/>
                    <!-- Gestión de Compras (2026-10-21): Compras entrega la requisición a Contabilidad. -->
                    <button name="action_fin_compras" string="Fin de intervención de Compras" type="object"
                            class="oe_highlight" icon="fa-check"
                            groups="purchase.group_purchase_user,account.group_account_manager"
                            confirm="¿Terminar la intervención de Compras? La requisición pasa a Contabilidad para Aplicar."
                            invisible="tipo != 'anticipo_materiales' or state != 'en_compras' or requiere_aprobacion_gerente or not es_procesador"/>
                    <button name="action_pasar_a_compras" string="Pasar a Gestión de Compras" type="object"
                            icon="fa-shopping-cart"
                            groups="purchase.group_purchase_user,account.group_account_manager"
                            confirm="¿Regresar la requisición a Gestión de Compras para cotizar y actualizar precios?"
                            invisible="tipo != 'anticipo_materiales' or state != 'aprobado' or not es_procesador"/>
                    <button name="action_autorizar_gerente" string="Autorizar monto (Gerente)" type="object"
                            class="oe_highlight" icon="fa-thumbs-up"
                            groups="construtec_account_payment_order_19.group_payment_order_approver_alto"
                            invisible="state != 'en_compras' or not requiere_aprobacion_gerente or not es_procesador"/>
                    <field name="requiere_aprobacion_gerente" invisible="1"/>
                    <button name="%(action_account_payment_order_quote_import_wizard)d"
                            type="action" string="Cargar Cotización" icon="fa-magic"
                            context="{'default_order_id': id}"
                            invisible="tipo != 'anticipo_materiales' or state != 'borrador' or es_procesador"/>
                    <button name="action_conciliar" string="Liquidar" type="object" class="oe_highlight"
                            groups="account.group_account_manager"
                            invisible="not puede_conciliar or not es_procesador"/>
                    <button name="action_cancelar" string="Cancelar" type="object"
                            groups="account.group_account_manager"
                            invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo') or state != 'liquidado' or not es_procesador"/>
                    <button name="action_generar_excel_transferencia_lote"
                            string="Generar Excel de Transferencia" type="object" icon="fa-file-excel-o"
                            invisible="not ordenes_hijas_count or not es_procesador"/>
                    <field name="es_procesador" invisible="1"/>
                    <field name="puede_conciliar" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,enviado,aprobado,aplicado,liquidado"
                           invisible="tipo not in ('anticipo', 'anticipo_viaticos')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,enviado,en_compras,aprobado,aplicado,liquidado"
                           invisible="tipo != 'anticipo_materiales'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,enviado,aprobado,liquidado"
                           invisible="tipo != 'pago_directo'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="tipo != 'anticipo_materiales' or not purchase_order_count">
                            <field name="purchase_order_count" widget="statinfo" string="Órdenes de Compra"/>
                        </button>
                        <button name="action_view_ordenes_hijas" type="object" class="oe_stat_button"
                                icon="fa-sitemap" invisible="not ordenes_hijas_count">
                            <field name="ordenes_hijas_count" widget="statinfo" string="Requisiciones Generadas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="analytic_account_id"
                                   invisible="tipo not in ('anticipo_viaticos', 'anticipo_materiales')"/>
                            <field name="proyecto" invisible="1"/>
                            <field name="journal_id" invisible="not es_procesador"
                                   domain="[('type', '=', 'bank')] if tipo in ('anticipo_viaticos', 'anticipo_materiales') else []"/>
                            <field name="available_payment_method_line_ids" invisible="1"/>
                            <field name="payment_method_line_id" invisible="not es_procesador"
                                   readonly="state not in ('borrador', 'aprobado')"/>
                            <field name="pagar_a" invisible="tipo != 'anticipo_materiales' or not es_procesador"/>
                            <field name="tecnico_deposito_partner_id"
                                   invisible="tipo != 'anticipo_materiales' or (es_procesador and pagar_a != 'tecnico')"
                                   readonly="state != 'borrador' and not es_procesador"
                                   options="{'no_create': True}"/>
                            <field name="proveedor_materiales_catalogo_id" string="Proveedor Sugerido"
                                   invisible="tipo != 'anticipo_materiales' or es_procesador"/>
                            <field name="proveedor_materiales_name"
                                   invisible="tipo != 'anticipo_materiales' or not es_procesador"/>
                            <field name="proveedor_materiales_id"
                                   invisible="tipo != 'anticipo_materiales' or not es_procesador"
                                   help="A quién se le va a pagar - se autosugiere solo (al recibir 'Proveedor Sugerido' por sincronización, y de nuevo al Aprobar/Aplicar/Crear Pago) buscando un contacto existente con ese nombre exacto o, si no hay ninguno exacto, uno parecido (solo si resulta en un único candidato, nunca adivina entre varios) - corrígelo si no es el correcto. Requerido antes de Generar Orden de Compra, y también antes de Aplicar si 'Pagar a' está en Proveedor Directo."/>
                            <!-- Mismo campo (partner_id), dos etiquetas - "Contacto" confundía en
                                 Pago Directo, donde siempre representa al proveedor real que se le
                                 va a pagar, no un contacto genérico (pedido explícito del usuario).
                                 Dos <field> mutuamente excluyentes por invisible=, mismo patrón ya
                                 usado en este archivo para "Proveedor Sugerido"/user_id. -->
                            <field name="partner_id" string="Proveedor"
                                   invisible="tipo != 'pago_directo'"/>
                            <field name="partner_es_contrata"
                                   invisible="tipo != 'pago_directo' or not partner_id"
                                   readonly="state != 'borrador' or es_procesador"/>
                            <field name="partner_id"
                                   invisible="tipo == 'pago_directo'"
                                   readonly="tipo in ('anticipo_viaticos', 'anticipo_materiales')"
                                   domain="[('employee', '=', True)] if tipo in ('anticipo_viaticos', 'anticipo_materiales') else []"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="periodo_del" invisible="tipo != 'anticipo_viaticos'"/>
                            <field name="periodo_al" invisible="tipo != 'anticipo_viaticos'"/>
                            <field name="user_id" invisible="tipo == 'anticipo_viaticos'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales')">
                        <group>
                            <field name="monto"
                                   readonly="tipo in ('anticipo_viaticos', 'anticipo_materiales') or state not in ('borrador', 'aprobado')"/>
                            <!-- Viáticos (110208) y Materiales (110204) usan una cuenta fija, ver
                                 CUENTA_ANTICIPO_POR_TIPO. -->
                            <field name="cuenta_anticipo_id" invisible="not es_procesador"
                                   force_save="1"
                                   readonly="tipo in ('anticipo_viaticos', 'anticipo_materiales') or state not in ('borrador', 'aprobado')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Factura a Pagar" invisible="tipo != 'pago_directo' or es_procesador">
                            <p class="text-muted">
                                Elige primero el Proveedor arriba - aquí solo se muestran sus Documentos
                                SAT, del más reciente al más antiguo (una Requisición de Pago Directo es para
                                un solo proveedor, nunca para varios). Puede ser una factura ya contabilizada
                                en Enterprise, o un Documento SAT que la SAT ya certificó pero que el
                                Contador todavía no ha convertido a factura (se convierte al Aprobar esta
                                Solicitud). Si es una factura grande, se puede pagar en varios abonos
                                (varias Solicitudes) - en cuanto una Orden cubre parte del saldo, la factura
                                queda libre para que otra Orden cubra el resto despues. Una factura ya
                                pagada al 100% no aparece en esta lista.
                            </p>
                            <field name="partner_vat_actual" invisible="1"/>
                            <field name="factura_mirror_ids" widget="many2many" nolabel="1"
                                   readonly="state != 'borrador'"
                                   domain="[('nit_contacto', '=', partner_vat_actual), ('disponible_pago', '=', True)]">
                                <list default_order="fecha_certificacion desc">
                                    <field name="partner_name" string="Proveedor"/>
                                    <field name="numero_documento" string="Número de Factura"/>
                                    <field name="serie" string="Serie de Factura"/>
                                    <field name="fecha_certificacion" string="Fecha"/>
                                    <field name="monto_total" string="Monto"/>
                                    <field name="move_amount_residual" string="Saldo"/>
                                    <field name="state" string="Estado de Documento" widget="badge"
                                           decoration-warning="state == 'pendiente'"
                                           decoration-success="state == 'convertido_factura'"/>
                                    <field name="move_payment_state" string="Estado de Pago" widget="badge"
                                           decoration-danger="move_payment_state == 'not_paid'"
                                           decoration-warning="move_payment_state in ('partial', 'in_payment')"
                                           decoration-success="move_payment_state in ('paid', 'reversed')"/>
                                    <field name="linked_order_name" string="Ya Vinculada A"/>
                                    <field name="numero_autorizacion" string="No. Autorización"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <!-- groups= además de invisible: "invisible" solo oculta en pantalla, no evita
                             que Odoo intente LEER estos campos (factura_ids/pago_ids/move_id apuntan a
                             account.move/account.payment) - un usuario sin ningún grupo de Contabilidad
                             (ej. un Jefe de Técnicos en Community, que nunca es "procesador") tronaba con
                             "Error de acceso" al abrir/actualizar la Orden, aunque la pestaña ni se le
                             mostrara. Bug real reportado por el usuario 2026-09-18 al usar "Depositar a
                             Mí" con un usuario sin permisos de Contabilidad. account.group_account_invoice
                             es uno de los grupos que el propio mensaje de error de Odoo ya listaba como
                             con acceso a account.move. -->
                        <page name="facturas_y_pagos" string="Facturas y Pagos" invisible="not es_procesador"
                              groups="account.group_account_invoice">
                            <div class="oe_title">
                                <h2>Facturas</h2>
                            </div>
                            <p class="text-muted" invisible="tipo not in ('anticipo', 'anticipo_viaticos', 'anticipo_materiales')">
                                Opcional en un Anticipo: si adjuntas una factura que el monto cubre al 100%,
                                el sistema te avisará al Aplicar que probablemente corresponde usar "Pago
                                Directo" en vez de un Anticipo pendiente de liquidar.
                            </p>
                            <p class="text-muted" invisible="tipo != 'pago_directo'">
                                Obligatorio en un Pago Directo: agrega al menos una factura. Al Conciliar, el
                                pago nunca puede exceder el saldo pendiente - si cubre menos, la factura queda
                                con el saldo restante disponible para que otra Orden lo cubra despues (nunca
                                usa Cuenta de Ajuste, a diferencia de un Anticipo).
                            </p>
                            <field name="factura_ids" widget="many2many" nolabel="1">
                                <list>
                                    <field name="made_sequence_gap" column_invisible="1"/>
                                    <field name="name" decoration-bf="1" decoration-danger="made_sequence_gap"/>
                                    <field name="date"/>
                                    <field name="partner_id" string="Proveedor"/>
                                    <field name="ref" string="Referencia Proveedor"/>
                                    <field name="amount_untaxed_signed"/>
                                    <field name="amount_total_signed" sum="Total"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-danger="payment_state == 'not_paid'"
                                           decoration-warning="payment_state in ('partial', 'in_payment')"
                                           decoration-success="payment_state in ('paid', 'reversed')"
                                           optional="show"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"
                                           decoration-info="state == 'draft'" optional="show"/>
                                </list>
                            </field>

                            <div class="oe_title">
                                <h2>Pagos/Cheques</h2>
                            </div>
                            <field name="pago_ids" widget="many2many" nolabel="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id" string="Contacto"/>
                                    <field name="memo" string="Memo"/>
                                    <field name="amount" widget="monetary" sum="Total"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                                           decoration-warning="state == 'in_process'"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state in ('canceled', 'rejected')"/>
                                </list>
                            </field>
                            <button name="action_crear_pago" string="Crear Pago" type="object"
                                    groups="account.group_account_manager"
                                    invisible="not puede_conciliar"/>

                            <group invisible="not puede_conciliar"
                                   class="oe_subtotal_footer oe_right">
                                <field name="diferencia_conciliacion" class="oe_subtotal_footer_separator"/>
                            </group>
                            <p class="text-muted" invisible="not puede_conciliar">
                                Positivo: faltan pagos por cubrir (usa "Crear Pago" o agrega uno a mano). Negativo:
                                faltan facturas, o hay pagos de más. En cero, Conciliar/Liquidar debería funcionar
                                sin pedir Cuenta de Ajuste.
                            </p>

                            <group>
                                <group>
                                    <field name="cuenta_ajuste_id"/>
                                </group>
                                <group>
                                    <field name="move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Viáticos" invisible="tipo != 'anticipo_viaticos'">
                            <group>
                                <field name="orden_padre_id" invisible="not orden_padre_id" readonly="1"/>
                                <field name="lote_origen" invisible="not lote_origen" readonly="1"/>
                                <field name="depositar_directo_tecnicos" invisible="1"/>
                            </group>
                            <field name="viaticos_line_ids" readonly="state != 'borrador'">
                                <list editable="bottom"
                                      decoration-danger="not cuenta_acreditar or not tipo_cuenta or not banco">
                                    <field name="employee_partner_id" required="1"/>
                                    <field name="departamento" optional="hide"/>
                                    <field name="puesto" optional="show"/>
                                    <field name="cantidad"/>
                                    <field name="costo_individual"/>
                                    <field name="total" sum="Total"/>
                                    <field name="viaticos_sin_liquidar_count" string="Sin Liquidar"
                                           decoration-warning="viaticos_sin_liquidar_count &gt; 0"/>
                                    <field name="cuenta_acreditar" optional="hide"/>
                                    <field name="tipo_cuenta" optional="hide"/>
                                    <field name="banco" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal"/>
                                <field name="anticipo_previo" readonly="state != 'borrador'"/>
                                <field name="total_acreditar" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <!-- Facturas de gastos (2026-10-17): el técnico vincula, desde Borrador y hasta
                             liquidar, las facturas con las que gastó el anticipo de Viáticos - sirven para
                             liquidarlo en Enterprise. Va justo después de la pestaña Viáticos (pedido del
                             usuario). Solo Community (es_procesador oculta la pestaña). -->
                        <page string="Facturas de Gastos" name="facturas_gastos"
                              invisible="tipo not in ('anticipo_viaticos', 'anticipo_materiales') or es_procesador or state not in ('borrador', 'enviado', 'aprobado', 'aplicado', 'liquidado')">
                            <p class="text-muted">
                                Agrega aquí las facturas (Documentos SAT) de lo que se compró o gastó con este
                                anticipo: sirven para liquidarlo. Puedes hacerlo desde que creas la requisición (viajan junto con
                                ella al enviarla) o después de enviarla, hasta que se liquide: ahí quedan guardadas
                                y se mandan a Enterprise con el botón "Enviar Facturas". Solo se
                                aceptan facturas con saldo vigente (sin ningún pago o pagadas parcialmente)
                                que no estén ya vinculadas a otra requisición. Mientras no se envíen puedes
                                quitarlas; una vez enviadas ya no se pueden quitar.
                                Con "Depositar a Técnicos" y varios técnicos, las facturas se agregan a la
                                requisición de cada técnico después de enviar.
                            </p>
                            <div class="alert alert-warning" role="alert" invisible="not gasto_pendiente_ids">
                                <p class="mb-1">
                                    <b>Facturas guardadas, pendientes de enviar a Enterprise:</b>
                                    <field name="gasto_pendiente_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                                </p>
                                <p class="mb-1">
                                    Estado: <field name="gasto_sync_state" readonly="1" nolabel="1"/>
                                    <span invisible="not gasto_sync_attempts"> · Intentos:
                                        <field name="gasto_sync_attempts" readonly="1" nolabel="1"/></span>
                                </p>
                                <p class="mb-1" invisible="not gasto_sync_error">
                                    <field name="gasto_sync_error" readonly="1" nolabel="1"/>
                                </p>
                                <p class="mb-2 text-muted" invisible="gasto_sync_state != 'error'">
                                    Falló la comunicación con Enterprise; se reintentan solas cada 15 minutos.
                                </p>
                                <button name="action_enviar_facturas_gastos" type="object" string="Enviar Facturas"
                                        class="btn btn-primary btn-sm" icon="fa-paper-plane"
                                        invisible="state == 'borrador'"/>
                            </div>
                            <div class="alert alert-success" role="status"
                                 invisible="gasto_pendiente_ids or gasto_sync_state != 'sincronizado'">
                                Todas las facturas de gastos están en Enterprise (último envío:
                                <field name="gasto_sync_date" readonly="1" nolabel="1"/>).
                                <field name="enterprise_url" widget="url" readonly="1" nolabel="1"
                                       string="Ver Requisición en Enterprise" invisible="not enterprise_url"/>
                            </div>
                            <field name="gasto_mirror_ids" widget="many2many" nolabel="1"
                                   readonly="state not in ('borrador', 'enviado', 'aprobado', 'aplicado')"
                                   domain="[('disponible_pago', '=', True), ('linked_order_name', '=', False)]">
                                <list default_order="fecha_certificacion desc">
                                    <field name="partner_name" string="Proveedor"/>
                                    <field name="numero_documento" string="Número de Factura"/>
                                    <field name="serie" string="Serie de Factura"/>
                                    <field name="fecha_certificacion" string="Fecha"/>
                                    <field name="monto_total" string="Monto"/>
                                    <field name="move_amount_residual" string="Saldo"/>
                                    <field name="move_payment_state" string="Estado de Pago" widget="badge"
                                           decoration-danger="move_payment_state == 'not_paid'"
                                           decoration-warning="move_payment_state in ('partial', 'in_payment')"
                                           decoration-success="move_payment_state in ('paid', 'reversed')"/>
                                    <field name="numero_autorizacion" string="No. Autorización"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cotizaciones" name="cotizaciones"
                              invisible="tipo != 'anticipo_materiales' or not es_procesador">
                            <div class="alert alert-warning" role="alert" invisible="not requiere_aprobacion_gerente">
                                Compras terminó, pero con los precios reales el total llegó al umbral de
                                aprobación: falta que un Gerente presione "Autorizar monto (Gerente)".
                            </div>
                            <p class="text-muted">
                                Suba aquí las cotizaciones que recibió de los proveedores (una, dos o tres).
                                Después actualice los precios en la pestaña Materiales, elija el Proveedor de
                                Materiales y genere o imprima la Orden de Compra (se actualiza con los precios
                                mientras siga en borrador). Vincule la factura en "Documentos SAT" y presione
                                "Fin de intervención de Compras" para pasarla a Contabilidad.
                            </p>
                            <field name="cotizacion_attachment_ids" widget="many2many_binary" nolabel="1"
                                   readonly="state not in ('en_compras', 'aprobado')"/>
                            <group invisible="not compras_finalizado_date">
                                <field name="compras_finalizado_por_id"/>
                                <field name="compras_finalizado_date"/>
                                <field name="aprobado_por_gerente"/>
                            </group>
                        </page>
                        <page string="Materiales" invisible="tipo != 'anticipo_materiales'">
                            <field name="material_line_ids"
                                   readonly="state not in ('borrador', 'en_compras', 'aplicado')">
                                <list editable="bottom">
                                    <field name="catalogo_id" optional="show" string="Producto SAT"
                                           context="{'vendor_hint': vendor_name}"
                                           readonly="parent.state != 'borrador'"/>
                                    <field name="product_name" required="1" optional="hide"
                                           readonly="parent.state != 'borrador'"/>
                                    <field name="description" optional="show" readonly="parent.state not in ('borrador', 'en_compras')"/>
                                    <field name="uom_name" optional="show" readonly="parent.state != 'borrador'"/>
                                    <field name="qty" readonly="parent.state not in ('borrador', 'en_compras')"/>
                                    <field name="estimated_price" readonly="parent.state not in ('borrador', 'en_compras')"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="vendor_name" optional="show"
                                           column_invisible="not parent.es_procesador"
                                           readonly="parent.state not in ('borrador', 'en_compras')"/>
                                    <field name="product_id" optional="show"
                                           column_invisible="not parent.es_procesador"
                                           help="Se resuelve aquí en Enterprise, una vez Aplicada la Orden - antes de Generar Orden de Compra. Dejar vacío si el material ya está en bodega propia (no se compra)."/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal"/>
                                <field name="anticipo_previo" readonly="state != 'borrador'"/>
                                <field name="total_acreditar" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Sincronización"
                              invisible="origin == 'synced' and not external_ref">
                            <group>
                                <field name="origin"/>
                                <field name="external_ref" invisible="not external_ref"/>
                                <field name="sync_state" invisible="origin == 'synced'"/>
                                <field name="sync_error" invisible="sync_state != 'error'"/>
                                <field name="sync_date" invisible="not sync_date"/>
                            </group>
                            <button name="action_retry_sync" string="Reintentar Sincronización" type="object"
                                    invisible="sync_state != 'error'"/>
                        </page>
                        <page string="Información">
                            <group invisible="tipo not in ('anticipo_viaticos', 'anticipo_materiales')">
                                <field name="tipo_cuenta"/>
                            </group>
                            <group invisible="tipo != 'anticipo_viaticos'">
                                <group>
                                    <field name="departamento"/>
                                    <field name="puesto"/>
                                    <field name="telefono"/>
                                    <field name="correo"/>
                                </group>
                                <group>
                                    <field name="cuenta_acreditar"/>
                                    <field name="banco"/>
                                    <field name="user_id"/>
                                </group>
                            </group>
                            <group string="Vínculo Community / Enterprise"
                                   invisible="not community_url and not enterprise_url">
                                <field name="community_url" widget="url" invisible="not community_url"
                                       string="Ver Requisición en Community"/>
                                <field name="enterprise_url" widget="url" invisible="not enterprise_url"
                                       string="Ver Requisición en Enterprise"/>
                            </group>
                            <p class="text-muted" invisible="community_url or enterprise_url">
                                Todavía no hay vínculo con la otra instalación: aparece cuando la
                                requisición se envía a Enterprise (o llega desde Community).
                            </p>
                        </page>
                    </notebook>
                    <group>
                        <field name="observaciones"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_payment_order_list" model="ir.ui.view">
        <field name="name">account.payment.order.list</field>
        <field name="model">account.payment.order</field>
        <field name="arch" type="xml">
            <list string="Requisiciones de Pago">
                <field name="name"/>
                <field name="fecha"/>
                <field name="tipo"/>
                <field name="partner_id"/>
                <field name="total_acreditar" sum="Total" optional="show"/>
                <field name="lote_origen" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('aplicado', 'liquidado')"
                       decoration-info="state == 'borrador'"
                       decoration-warning="state in ('enviado', 'aprobado')"
                       decoration-danger="state in ('rechazado', 'cancelado')"/>
            </list>
        </field>
    </record>

    <record id="view_account_payment_order_search" model="ir.ui.view">
        <field name="name">account.payment.order.search</field>
        <field name="model">account.payment.order</field>
        <field name="arch" type="xml">
            <search string="Requisiciones de Pago">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lote_origen" string="Lote de Origen"/>
                <filter string="Mis Requisiciones" name="my_orders"
                        domain="[('tipo', 'in', ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo')), ('requested_by_id', '=', uid)]"/>
                <filter string="Pendientes de Aprobar" name="pendientes"
                        domain="[('tipo', 'in', ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo')), ('state', '=', 'enviado')]"/>
                <filter string="Aprobadas" name="aprobadas"
                        domain="[('tipo', 'in', ('anticipo', 'anticipo_viaticos', 'anticipo_materiales', 'pago_directo')), ('state', '=', 'aprobado')]"/>
                <filter string="Anticipos Liquidados" name="anticipos_liquidados"
                        domain="[('tipo', 'in', ('anticipo', 'anticipo_viaticos', 'anticipo_materiales')), ('state', '=', 'liquidado')]"/>
                <filter string="Anticipos sin Liquidar" name="anticipos_sin_liquidar"
                        domain="[('tipo', 'in', ('anticipo', 'anticipo_viaticos', 'anticipo_materiales')), ('state', '=', 'aplicado')]"/>
                <separator/>
                <!-- Por defecto no se ven las liquidadas ni las divididas (pedido del usuario, 2026-10-22);
                     quitando este filtro se ven todas. Va separado para combinarse (Y) con los de arriba. -->
                <filter string="En proceso" name="en_proceso"
                        domain="[('state', 'not in', ('liquidado', 'dividida'))]"/>
                <separator/>
                <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Lote de Origen" name="group_lote_origen" context="{'group_by': 'lote_origen'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_payment_order" model="ir.actions.act_window">
        <field name="name">Requisiciones de Pago</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_orders': 1, 'search_default_en_proceso': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una Requisición de Pago.</p>
        </field>
    </record>

    <!-- App propia (sin parent) - antes vivía dentro de Facturación (account.menu_finance_payables),
         pedido explícito del usuario 2026-09-18: que Órdenes de Pago sea su propia app, con su
         propio ícono (static/description/icon.png). Al ser el propio root el que trae la action,
         el ícono de la app abre directo esta lista - los otros 2 menús de este módulo (Importar
         Solicitudes, Viáticos sin Liquidar) ahora cuelgan de este mismo root en vez de Facturación. -->
    <menuitem action="action_account_payment_order" id="menu_account_payment_order"
              name="Requisiciones de Pago" web_icon="construtec_account_payment_order_19,static/description/icon.png"
              sequence="21"/>

    <record id="action_account_payment_order_generar_excel_transferencia" model="ir.actions.server">
        <field name="name">Generar Excel de Transferencia</field>
        <field name="model_id" ref="model_account_payment_order"/>
        <field name="binding_model_id" ref="model_account_payment_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_generar_excel_transferencia()</field>
    </record>
</odoo>
