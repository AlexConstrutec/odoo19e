<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payment.order.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Solicitudes de Pago" name="payment_order_request_settings">
                    <setting id="payment_order_role" string="Rol de esta instalación"
                             help="Solicitante: captura y aprueba Solicitudes de Pago y las sincroniza. Procesador: recibe Solicitudes aprobadas y las convierte en Órdenes de Pago reales.">
                        <field name="payment_order_role" widget="radio"/>
                    </setting>
                </block>
                <block title="Tipos de Orden de Pago disponibles al crear" name="payment_order_tipos_settings"
                       help="Controla qué opciones aparecen en el campo Tipo al crear una Orden de Pago nueva en esta compañía. No afecta órdenes ya existentes ni las que llegan por sincronización.">
                    <setting id="payment_order_habilitar_anticipo" string="Anticipo">
                        <field name="payment_order_habilitar_anticipo"/>
                    </setting>
                    <setting id="payment_order_habilitar_anticipo_viaticos" string="Anticipo Viáticos">
                        <field name="payment_order_habilitar_anticipo_viaticos"/>
                    </setting>
                    <setting id="payment_order_habilitar_pago_directo" string="Pago Directo">
                        <field name="payment_order_habilitar_pago_directo"/>
                    </setting>
                    <setting id="payment_order_habilitar_anticipo_materiales" string="Solicitud de Materiales">
                        <field name="payment_order_habilitar_anticipo_materiales"/>
                    </setting>
                </block>
                <block title="Aprobación por Monto" name="payment_order_approval_settings"
                       invisible="payment_order_role != 'procesador'">
                    <setting id="payment_order_approval_threshold" string="Umbral de Aprobación Nivel Alto"
                             help="Solicitudes con Total a Acreditar mayor o igual a este monto requieren
                                   Nivel Alto (Gerente de Área); montos menores solo requieren Nivel Medio
                                   (Jefe de Área). Nivel Alto siempre puede aprobar cualquier monto.">
                        <field name="payment_order_approval_threshold"/>
                    </setting>
                </block>

                <!-- Pedido explícito del usuario (2026-09-30): "ordena un poquito los botones de
                     sincronización que estén más juntos... cada botón tenga una descripción qué es
                     lo que sincroniza... y los logs estén también en un apartado, pero algo juntos."
                     Antes esto vivía repartido en 3 bloques separados ("Sincronización de
                     Solicitudes de Pago"/"Sincronización de Empleados"/"Catálogo de Materiales"),
                     cada uno con su propio botón mezclado entre credenciales/toggles - fácil
                     perderse buscando cuál botón hace qué. Ahora es UN solo bloque con las
                     credenciales arriba (compartidas por los 4 botones) y cada "Sincronizar ahora"
                     con su propia descripción de una línea justo encima - el registro (log) se
                     separó a su propio bloque, al final, para no interrumpir la lista de botones. -->
                <block title="Sincronización con Enterprise" name="payment_order_sync_settings"
                       invisible="payment_order_role != 'solicitante'">
                    <setting id="payment_order_sync_enabled" string="Sincronización Habilitada"
                             help="Interruptor maestro - con esto apagado, ninguna de las sincronizaciones de abajo hace nada (ni botones, ni los cron automáticos).">
                        <field name="payment_order_sync_enabled"/>
                    </setting>
                    <setting string="Credenciales de la instalación Procesadora (Enterprise)"
                             help="Usadas por TODAS las sincronizaciones de este bloque - una sola vez, no hay que repetirlas por cada una."
                             invisible="not payment_order_sync_enabled">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="payment_order_sync_url" class="col-lg-3 o_light_label"/>
                                <field name="payment_order_sync_url" placeholder="https://enterprise.miempresa.com"/>
                            </div>
                            <div class="row mt8">
                                <label for="payment_order_sync_db" class="col-lg-3 o_light_label"/>
                                <field name="payment_order_sync_db"/>
                            </div>
                            <div class="row mt8">
                                <label for="payment_order_sync_login" class="col-lg-3 o_light_label"/>
                                <field name="payment_order_sync_login"/>
                            </div>
                            <div class="row mt8">
                                <label for="payment_order_sync_api_key" class="col-lg-3 o_light_label"/>
                                <field name="payment_order_sync_api_key" password="True"/>
                            </div>
                            <div class="text-muted mt8">
                                Use un usuario de integración dedicado en la instalación Procesadora con
                                permisos mínimos (solo crear Solicitudes de Pago) y su API Key
                                (no su contraseña). Genere la API Key desde Ajustes &gt; Mi Perfil &gt;
                                Seguridad de la cuenta &gt; Nueva clave API.
                            </div>
                            <div class="mt8">
                                <button name="action_test_payment_order_sync_connection" type="object"
                                        string="Probar conexión" class="btn btn-secondary" icon="fa-plug"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="payment_order_status_sync_interval"
                             string="1. Estado de Órdenes de Pago"
                             help="Consulta si tus Solicitudes ya enviadas fueron Aprobadas, Rechazadas o
                                   Aplicadas en Enterprise - sin esto, quedarían congeladas en 'Enviado'
                                   para siempre en esta instalación."
                             invisible="not payment_order_sync_enabled">
                        <div class="d-flex">
                            <field name="payment_order_status_sync_interval_number" class="me-2" style="width: 80px"/>
                            <field name="payment_order_status_sync_interval_type"/>
                        </div>
                        <button name="action_pull_payment_order_status_now" type="object"
                                string="Sincronizar ahora" class="btn btn-secondary mt8" icon="fa-refresh"/>
                    </setting>

                    <setting id="employee_sync_interval" string="2. Directorio (Empleados, Contactos, Cuentas Analíticas, Compañías)"
                             help="Trae desde Enterprise: nombre/departamento/puesto de empleados,
                                   contactos etiquetados Cliente/Proveedor, el catálogo de Cuentas
                                   Analíticas (Proyectos/Ubicaciones) y la lista de compañías - los
                                   empleados y cuentas analíticas siempre se crean en Enterprise, nunca
                                   a mano aquí."
                             invisible="not payment_order_sync_enabled">
                        <div class="d-flex">
                            <field name="employee_sync_interval_number" class="me-2" style="width: 80px"/>
                            <field name="employee_sync_interval_type"/>
                        </div>
                        <button name="action_sync_employees_now" type="object"
                                string="Sincronizar ahora" class="btn btn-secondary mt8" icon="fa-refresh"/>
                    </setting>
                    <setting id="payment_order_default_company" string="Compañía por defecto en Enterprise"
                             help="Enterprise puede tener varios empleados contratados en distintas compañías.
                                   Esta es la compañía a la que caen las Solicitudes de Pago cuando el
                                   empleado no se pudo resolver a un id real de Enterprise (ej. no está
                                   sincronizado todavía) - cuando sí se resuelve, se usa la compañía real de
                                   ese empleado en su lugar."
                             invisible="not payment_order_sync_enabled">
                        <field name="payment_order_default_company_id"
                               placeholder="Sincronice para ver la lista de compañías"/>
                    </setting>

                    <setting id="materials_catalog_sync_enabled" string="3. Catálogo de Materiales"
                             help="Jala periódicamente (y bajo demanda) la copia local de Enterprise del
                                   Catálogo de Materiales, Proveedores y Facturas (derivados de los
                                   Documentos SAT) - usa las mismas credenciales de arriba.">
                        <field name="materials_catalog_sync_enabled"/>
                    </setting>
                    <setting id="materials_catalog_sync_interval" string="&#160;"
                             invisible="not materials_catalog_sync_enabled">
                        <div class="d-flex">
                            <field name="materials_catalog_sync_interval_number" class="me-2" style="width: 80px"/>
                            <field name="materials_catalog_sync_interval_type"/>
                        </div>
                        <button name="action_sync_materials_catalog_now" type="object"
                                string="Sincronizar ahora" class="btn btn-secondary mt8" icon="fa-refresh"/>
                    </setting>

                    <setting id="sat_document_sync" string="4. Documentos SAT"
                             invisible="not materials_catalog_sync_enabled"
                             help="Réplica de solo lectura de los Documentos SAT de compra de Enterprise
                                   (mismo modelo, mismos campos) - solo los creados o modificados en los
                                   últimos 7 días en cada corrida, para no releer todo el histórico cada vez.
                                   Corridas sucesivas van completando el histórico real solas.">
                        <button name="action_sync_sat_documents_now" type="object"
                                string="Sincronizar Documentos SAT" class="btn btn-secondary mt8"
                                icon="fa-refresh"/>
                    </setting>
                </block>

                <block title="Registro de Sincronización" name="payment_order_sync_log_settings"
                       invisible="payment_order_role != 'solicitante' or not payment_order_sync_enabled">
                    <setting string="Intentos recientes (los 4 botones de arriba escriben aquí)">
                        <field name="payment_order_sync_log_ids" nolabel="1">
                            <list create="0" delete="0" default_order="create_date desc">
                                <field name="create_date" string="Fecha"/>
                                <field name="success"/>
                                <field name="message"/>
                            </list>
                        </field>
                    </setting>
                </block>

                <block title="IA para Cotizaciones (Anthropic)" name="quote_import_ai_settings"
                       invisible="payment_order_role != 'solicitante'">
                    <setting id="anthropic_api_key" string="Anthropic API Key"
                             help="Se usa para transcribir cotizaciones de proveedor subidas en la
                                   pestaña Materiales ('Cargar Cotización'). Cada extracción tiene
                                   un costo real por llamada - no comparta esta clave. Genere una
                                   en console.anthropic.com.">
                        <field name="anthropic_api_key" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
