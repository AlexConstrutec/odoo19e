<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_employee_job_info" model="ir.ui.view">
        <field name="name">res.partner.view.form.employee.job.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="function" position="after">
                <field name="employee_job_title" string="Puesto (Empleado)" readonly="1"
                       invisible="not employee"/>
                <field name="employee_department_id" string="Departamento (Empleado)" readonly="1"
                       invisible="not employee"/>
            </field>
        </field>
    </record>
</odoo>
