<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_employee_job_info" model="ir.ui.view">
        <field name="name">res.partner.view.form.employee.job.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- "Puesto" ya es el campo nativo `function` (base.view_partner_form lo muestra
                 de por si) - solo hace falta agregar el departamento, que no tiene equivalente
                 nativo en res.partner. -->
            <field name="function" position="after">
                <field name="employee_department_id" string="Departamento (Empleado)" readonly="1"
                       invisible="not employee"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_form_partner_sync" model="ir.ui.view">
        <field name="name">res.partner.view.form.partner.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <div class="alert alert-danger" role="alert"
                     invisible="partner_sync_state != 'error'">
                    <strong>Error al sincronizar este contacto hacia Enterprise:</strong>
                    <field name="partner_sync_error" readonly="1" nolabel="1"/>
                    <button name="action_retry_partner_sync" type="object"
                            string="Reintentar Sincronización" class="btn-link p-0"/>
                </div>
            </sheet>
        </field>
    </record>
</odoo>
