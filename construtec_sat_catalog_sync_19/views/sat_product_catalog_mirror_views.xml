<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construtec_sat_product_catalog_mirror_list" model="ir.ui.view">
        <field name="name">construtec.materials.catalog.mirror.list</field>
        <field name="model">construtec.materials.catalog.mirror</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="pendiente_verificar">
                <field name="name"/>
                <field name="codigo"/>
                <field name="partner_name"/>
                <field name="precio_referencia"/>
                <field name="ultima_fecha_compra"/>
                <field name="pendiente_verificar"/>
                <field name="received_date"/>
            </list>
        </field>
    </record>

    <record id="view_construtec_sat_product_catalog_mirror_search" model="ir.ui.view">
        <field name="name">construtec.materials.catalog.mirror.search</field>
        <field name="model">construtec.materials.catalog.mirror</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="codigo"/>
                <field name="partner_name"/>
                <filter string="Pendientes de Verificar" name="pendientes_verificar"
                        domain="[('pendiente_verificar', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_construtec_sat_product_catalog_mirror" model="ir.actions.act_window">
        <field name="name">Catálogo de Materiales</field>
        <field name="res_model">construtec.materials.catalog.mirror</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay ningún producto curado en el catálogo.
            </p>
        </field>
    </record>

    <menuitem id="menu_construtec_sat_catalog_sync_root" name="Catálogo de Materiales"
              sequence="60"/>
    <menuitem action="action_construtec_sat_product_catalog_mirror"
              id="menu_construtec_sat_product_catalog_mirror"
              parent="menu_construtec_sat_catalog_sync_root"/>
</odoo>
