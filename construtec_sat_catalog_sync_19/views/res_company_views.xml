<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_materials_catalog_sync" model="ir.ui.view">
        <field name="name">res.company.form.materials.catalog.sync</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Catálogo de Materiales (Sync)" name="materials_catalog_sync">
                    <group>
                        <field name="materials_catalog_sync_enabled"/>
                    </group>
                    <group invisible="not materials_catalog_sync_enabled">
                        <group string="Conexión con Enterprise">
                            <field name="materials_catalog_sync_url" placeholder="https://enterprise.miempresa.com"/>
                            <field name="materials_catalog_sync_db"/>
                            <field name="materials_catalog_sync_login"/>
                            <field name="materials_catalog_sync_api_key" password="True"/>
                        </group>
                        <group string="Intervalo">
                            <label for="materials_catalog_sync_interval_number" string="Sincronizar cada"/>
                            <div class="o_row">
                                <field name="materials_catalog_sync_interval_number"/>
                                <field name="materials_catalog_sync_interval_type" nolabel="1"/>
                            </div>
                            <button name="action_sync_materials_catalog_now" type="object"
                                    string="Sincronizar Ahora" class="btn-secondary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
